# Infrastructure branch .gitignore
# Exclude only what we don't want

# Raw worldbooks (already in git from master — keep tracking)
# campaigns/world-library/imports/worldviews/ — keep tracking

# Exclude large raw data
campaigns/world-library/imports/worldbooks-pending/
campaigns/world-library/imports/images/
campaigns/world-library/imports/reports/
campaigns/world-library/reports/

# Exclude project noise
node_modules/
.idea/
backup/
novel/
knowledge/
nul
*.png
*.webp
.VSCodeCounter/

# Release lock file (never commit)
.rp-lock

# Generated curation backups
*.bak-*

# Local temp/intermediate state
.worktrees/
tmp/
work/
merged/
*.stackdump

# Manual curation intermediate workspaces (keep local, do not push)
/campaigns/world-library/manual-curation/*-output/
/campaigns/world-library/manual-curation/*-p1-output/
/campaigns/world-library/manual-curation/*-p1-style/
/campaigns/world-library/manual-curation/type-moon-p1-hybrid/
