              "https://www.bilibili.com/opus/792693728589381632"
            ]
          },
          "丛云劾": {
            "id": "char-丛云劾",
            "name": "丛云劾",
            "summary": "【性别：男】【年龄：26岁】【血型：不明】【身高：180CM】【体重：不明】【出生日期：C.E.45年*月*日】【出生地：不明】【所属：雇佣兵部队蛇尾】【职业：MS驾驶员】【职业阶级：最强佣兵】【在历史背后所展开的劾与蓝异端的战斗】C.E.71年，调整者与自然人的对立愈演愈烈，终于到了全面战争的地步。这场战争被不是PLANT和地球联合任意一方的第三方势力化上了休止符，引导战争终结的基拉·大和与阿斯兰·萨拉也被人传颂为英雄。然而，在那些人活跃的背后，有一个被称为最强佣兵的名为“丛云劾”的人物，也是与废品商工会的罗·裘尔一同担当着推动历史的宠儿。在可以说是成为战争转机的地球联合第1期GAT-X系列抢夺事件的背后，作为雇佣兵部队“蛇尾”的领导者丛云劾也被卷入了围绕“异端高达”所展开的奥布内讧当中。于是，丛云劾就这样遇到了罗·裘尔，还获到了异端高达蓝色机。通过这架机体，与奥布五大氏族中的隆德·吉纳·萨哈克的野心锋芒相对，劾被牵扯进了各种各样的事件里。在那之后，蓝异端高达便成为了劾开拓道路的一柄利剑。",
            "aliases": [
              "丛云劾"
            ],
            "factions": [],
            "powerSystems": [],
            "importance": "secondary",
            "sourceRefs": [
              "https://www.bilibili.com/opus/935763246599634979"
            ]
          },
          "迪兰达尔": {
            "id": "char-迪兰达尔",
            "name": "迪兰达尔",
            "summary": "【性别：男】【年龄：32岁】【血型：AB型】【身高：183CM】【体重：69KG】【出生日期：C.E.41年11月19日】【出生地：PLANT】【所属：PLANT评议会】【职业：基因工学家、政治家】【职业阶级：PLANT最高评议会议长】【与地球联合军高度对峙的PLANT新领导者】（前期）第2次雅金·杜维攻防战结束后，扎夫特和地球联合军前所未有的大战终于停战了。扎夫特这边的艾琳·卡纳巴成为临时议长，与地球方面签订包括裁军在内的停战条约《尤尼乌斯条约》，在这次战争的反省上构筑新的世界格局。之后，PLANT进行了评议会员的选举，选出了新的议长——吉尔伯特·迪兰达尔。基因工程专家出身的迪兰达尔议长提出了与敌视地球联合军和自然人的前议长帕特里克·萨拉的政策划清界限，重视对话的政策方针。在前次大战中受到巨大伤害的PLANT市民们对此表示赞同。因此迪兰达尔议长获得了很大的支持。另一方面，迪兰达尔议长在不违反《尤尼乌斯条约》的范围内对军备进行整备。【提出“歼灭LOGOS”的扎夫特领导者终于表明了真正的目的】（后期）在前次大战的反省中，重视与地球联合对话的PLANT最高评议会议长吉尔伯特·迪兰达尔，在“Break the world”事件之后",
            "aliases": [
              "迪兰达尔"
            ],
            "factions": [],
            "powerSystems": [],
            "importance": "secondary",
            "sourceRefs": [
              "https://www.bilibili.com/opus/646855609970327556"
            ]
          },
          "迪亚哥": {
            "id": "char-迪亚哥",
            "name": "迪亚哥",
            "summary": "【性别：男】【年龄：17岁】【血型：AB型】【身高：176CM】【体重：67.5KG】【出生日期：C.E.54年3月29日】【出生地：PLANT】【所属：扎夫特、独立部队大天使号】【职业：MS驾驶员】【职业阶级：扎夫特红衣】【作为暴风高达的驾驶员体验到战争的严酷】（前期）扎夫特的克鲁泽队，有很多来自军校的精英士兵，参加赫里奥波利斯的“G”夺取作战任务的迪亚哥·艾尔斯曼就是被称为“红衣”的精英驾驶员之一，也是一直站在C.E.71年爆发的战争最前线的少年。迪亚哥是有着在PLANT最高评议会任职的父亲达特·艾尔斯曼这样优秀的出身背景，一直关注着为国家操劳的父亲的迪亚哥，在“血之情人节”事件发生以后，为了陷入危机状况的PLANT而进入军校，可以说是必然的结果。在军校里，他与同样有着PLANT最高评议会议员背景出身的阿斯兰·萨拉、伊扎克·玖尔、尼高尔·阿玛菲等人相遇，并结下了情谊。以优异的成绩毕业于军校后，他与伊扎克和阿斯兰等人一起加入了克鲁泽队，在“G”夺取作战任务中成功抢夺到了暴风高达。【从米莉的交流中决心脱离扎夫特加入独立部队】（后期）迪亚哥身为扎夫特萨拉小队的成员，参加了在马绍尔群岛上与大天使号的战斗，在激烈的战斗中，爱机暴风",
            "aliases": [
              "迪亚哥",
              "迪亚哥（CE71年）",
              "迪亚哥（CE73年）"
            ],
