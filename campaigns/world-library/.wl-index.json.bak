      "world": {
        "powerSystems": [
          {
            "id": "demonic-power",
            "name": "恶魔之力",
            "summary": ""
          },
          {
            "id": "sacred-gear",
            "name": "神器 (Sacred Gear)",
            "summary": ""
          },
          {
            "id": "holy-power",
            "name": "神圣之力",
            "summary": ""
          },
          {
            "id": "senjutsu",
            "name": "仙术",
            "summary": ""
          },
          {
            "id": "dragon-power",
            "name": "龙之力",
            "summary": ""
          }
        ],
        "factions": [
          {
            "id": "devil-underworld",
            "name": "恶魔/冥界",
            "summary": "由72柱纯血恶魔家族和新魔王政府统治的冥界社会。四大魔王（路西法、别西卜、利维坦、阿斯莫德）为最高行政长官。通过恶魔棋子将其他种族转生为眷属扩大势力。核心制度为排名游戏。主要家族：吉蒙里、西迪、巴力、"
          },
          {
            "id": "heaven-angels",
            "name": "天界/天使",
            "summary": "由炽天使米迦勒领导的圣经三势力之一。神已死，依靠「系统」维持运作。无法增加天使数量，处于衰退中。与恶魔停战合作。"
          },
          {
            "id": "fallen-angels",
            "name": "堕天使",
            "summary": "从天界堕落的原天使。由总督阿撒塞勒领导。技术力强，研究神器。与恶魔/天使停战后转向科研。核心组织「神之子监视者」。"
          },
          {
            "id": "gremory-family",
            "name": "吉蒙里家族",
            "summary": "72柱公爵家之一。现任家主瑟杰克斯·吉蒙里（实为魔王路西法），继承人莉雅丝·吉蒙里。领地面积堪比日本本州。核心人物为莉雅丝及其眷属恶魔。"
          },
          {
            "id": "khaos-brigade",
            "name": "祸之团",
            "summary": "由无限龙神奥菲斯为首、聚集各势力离反者的恐怖组织。分多个派系：英雄派（曹操领导）、瓦利队、旧魔王派等。目标是颠覆现有秩序。"
          },
          {
            "id": "vali-team",
            "name": "瓦利队",
            "summary": "白龙皇瓦利·路西法领导的独立战斗团队。成员包括美猴、亚瑟·潘德拉刚、勒菲·潘德拉刚、黑歌等。原属祸之团，后独立行动。以战斗和变强为目的。"
          },
          {
            "id": "hero-faction",
            "name": "英雄派",
            "summary": "祸之团下属派系，由人类英雄/神灭具持有者曹操领导。成员包括格奥尔克、齐格飞、贞德等。主张人类至上，对抗神话势力。"
          },
          {
            "id": "norse-mythology",
            "name": "北欧神族",
            "summary": "以北欧主神奥丁为首的北欧神话势力。与圣经三势力有外交关系。主要战力：奥丁、女武神（罗丝薇瑟等）、雷神托尔、恶神洛基、芬里尔等。"
          },
          {
            "id": "greek-mythology",
            "name": "希腊神族",
            "summary": "以奥林匹斯为中心的希腊神话势力。宙斯、哈迪斯、波塞冬为三柱神。哈迪斯曾与祸之团合作对抗恶魔。"
          },
          {
            "id": "japanese-mythology",
            "name": "日本神道/妖怪势力",
            "summary": "以京都为中心的日本本土势力。由九尾狐八坂率领妖怪势力。包括妖怪、神道众神。与恶魔有外交关系，京都妖怪与吉蒙里家有合作。"
          },
          {
            "id": "hindu-mythology",
            "name": "印度神话势力",
            "summary": "印度神族，战力极强。主神湿婆、毗湿奴、梵天。被视为最强神话势力之一。帝释天（因陀罗）亦属此体系。"
          },
          {
            "id": "sitri-family",
            "name": "西迪家族",
            "summary": "72柱公爵家之一。继承人支取苍那（索娜·西迪）。以学术和策略著称，眷属组成学生会。与吉蒙里家是盟友/竞争对手。"
          },
          {
            "id": "old-satan-faction",
            "name": "旧魔王派",
            "summary": "由旧四大魔王的后裔组成的反政府势力。主张恢复旧恶魔体制。成员包括夏尔巴·别西卜等。与祸之团合作。"
          }
        ],
        "rules": [
          {
            "id": "evil-pieces",
            "name": "恶魔棋子（Evil Pieces）系统",
            "summary": "由阿邱卡·别西卜发明的转生系统。高级恶魔可用棋子将其他种族转生为恶魔眷属。1组15枚：King(1)、Queen(1)、Rook(2)、Knight(2)、Bishop(2)、Pawn(8)。每个棋子"
          },
          {
            "id": "rating-game",
            "name": "排名游戏（Rating Game）",
            "summary": "恶魔社会的核心竞技/政治制度。恶魔眷属间在异空间战场进行战术对抗，击倒敌方King为胜利。结果影响恶魔爵位和领地。分为正式排名游戏和非正式练习赛。"
          },
          {
            "id": "sacred-gear-mechanics",
            "name": "神器机制",
            "summary": "神器寄宿于持有者灵魂中，通过强烈情感或意志触发。可通过修炼达到「禁手（Balance Breaker）」——神器的进化形态。神灭具级可达到「真·禁手」乃至「霸龙」形态。神器不可移除（除非持有者死亡）。"
          },
          {
            "id": "three-faction-peace",
            "name": "三方和平协定",
            "summary": "天使、堕天使、恶魔三方的正式和平条约。禁止三方间的大规模军事行动。设立联合应对机制处理超越三方的威胁（如祸之团）。"
          },
          {
            "id": "mythological-non-interference",
            "name": "神话不干涉原则",
            "summary": "各神话体系间默认互不干涉内政。重大事件需通过外交渠道沟通。但无强制性执行机制——实力强者可无视。"
          }
        ],
        "locations": [
          {
            "id": "kuoh-town",
            "name": "驹王镇",
            "summary": "日本某地的普通城镇，实为吉蒙里家在日本的重要据点。镇上有驹王学园（神秘学研究社的据点）、旧校舍、兵藤家等。表面和平，暗流涌动。"
          },
          {
            "id": "underworld",
            "name": "冥界",
            "summary": "恶魔与堕天使的故乡，与人间同样广阔但没有海洋的异次元空间。天空永远是诡异的紫色。由各恶魔家族分治。主要交通为魔力驱动的列车。"
          },
          {
            "id": "gremory-territory",
            "name": "吉蒙里领地",
            "summary": "吉蒙里公爵家的领地，面积堪比日本本州。境内有广阔的森林、山脉，宏伟的城堡和别馆。"
          },
          {
            "id": "heaven",
            "name": "天界",
            "summary": "由圣经之神创造的、充满神圣气息与光芒的最高层维度。天使们的居所，秩序与和平的象征。"
          },
          {
            "id": "dimensional-gap",
            "name": "次元间隙",
            "summary": "存在于各世界夹缝中的虚无空间。是无限龙神奥菲斯和伟大之赤（Great Red）的故乡与战场。也是祸之团的据点。"
          },
          {
            "id": "kyoto",
            "name": "京都",
            "summary": "日本古都，日本妖怪势力的核心。由九尾狐八坂统率。与吉蒙里家有同盟关系。"
          },
          {
            "id": "asgard",
            "name": "阿斯加德",
            "summary": "北欧神族的居城，以世界树为中心的领域。由主神奥丁统治。"
          },
          {
            "id": "olympus",
            "name": "奥林匹斯",
            "summary": "希腊神族的领域。三柱神（宙斯、哈迪斯、波塞冬）各自管辖不同区域。"
          }
        ],
        "events": [
          {
            "id": "issei-rebirth",
            "name": "一诚转生",
            "summary": "高中二年级生兵藤一诚被堕天使丽娜丽杀害后，被莉雅丝·吉蒙里以恶魔棋子（8枚Pawn）转生为恶魔眷属，成为「赤龙帝的笼手」持有者。"
          },
          {
            "id": "peace-conference",
            "name": "三方和谈",
            "summary": "天使、堕天使、恶魔三方在驹王学园举行和平会议。祸之团袭击会场，一诚与瓦利首次激战。和谈最终成功，三方建立合作关系。"
          },
          {
            "id": "rating-game-debut",
            "name": "排名游戏初战",
            "summary": "吉蒙里眷属vs菲尼克斯眷属的正式排名游戏。一诚在战斗中觉醒「赤龙帝的笼手」禁手，逆转战局。"
          },
          {
            "id": "hero-faction-war",
            "name": "英雄派战争",
            "summary": "祸之团英雄派（曹操等人）攻击各势力。一诚、瓦利、各神话势力联合对抗英雄派。一诚在与曹操战斗中觉醒真·禁手（Cardinal Crimson Promotion）。"
          },
          {
            "id": "trihexa-seal",
            "name": "666封印战",
            "summary": "兽皇666（Trihexa）苏醒。各神话势力主力联合将其封印于隔离空间，多位强者困入其中进行永续战斗。一诚以D×D形态参与战役。"
          },
          {
            "id": "biblical-god-death",
            "name": "圣经之神之死",
            "summary": "在三大势力战争期间，圣经之神与四大魔王同归于尽。此事实对普通人类信徒保密。天使靠神遗留的「系统」维持运作。"
          },
          {
            "id": "ophis-manipulation",
            "name": "奥菲斯被操纵",
            "summary": "祸之团英雄派利用无限龙神奥菲斯渴望回到次元间隙的愿望操纵她。奥菲斯实际上被英雄派利用而非真正的领导者。"
          },
          {
            "id": "exe-world",
            "name": "ExE异世界",
            "summary": "来自异世界的机械生命体Evie和ExE势力。后期威胁，在23卷后正式登场。由「罗伊根·贝尔芬格」和「鬼神」率领。"
          }
        ],
        "timelines": [
          {
            "id": "great-war",
            "name": "great-war",
            "summary": "天使、堕天使、恶魔三方的大规模战争。圣经之神与四大魔王在战争中陨落。战争以三方停战协定结束，但三方均元气大伤。"
          },
          {
            "id": "post-war-era",
            "name": "post-war-era",
            "summary": "三方停战后重建。恶魔建立新魔王制度和排名游戏体系。天使依靠系统维持。堕天使转向科研。"
          },
          {
            "id": "main-story",
            "name": "main-story",
            "summary": "兵藤一诚成为恶魔后的冒险。从莉雅丝眷属起步，经历与堕天使、祸之团、英雄派、北欧恶神、冥界哈迪斯等势力的战斗，最终面对次元级威胁。"
          }
        ],
        "extensions": [
          "noblePhantasms",
          "servantClasses",
          "commandSeals",
          "sacredGearTypes",
          "longinus13",
          "dragonTypes",
          "mythologyPantheons"
        ]
      },
