        "majorCharacters": []
      },
      "world": {
        "powerSystems": [
          {
            "id": "is-core",
            "name": "IS核心",
            "summary": "IS机体的核心单元，全球仅467个。决定机体性能和特性，可与驾驶员精神同步。核心网络可共享数据。"
          },
          {
            "id": "personal-is",
            "name": "专用机持有",
            "summary": "代表候补生持有各国专属开发的第三世代IS。日本:白式(近战)、英国:蓝色眼泪(狙击)、中国:甲龙(炮击)、德国:黑雨(重装)、法国:迷雾淑女(多用途)、俄罗斯:沉默西风(电子战)。"
          },
          {
            "id": "one-off-ability",
            "name": "一击必杀(O.O.A.)",
            "summary": "第三世代IS机体的特殊能力。每机一个，发动条件苛刻但命中即终结战斗。白式:零落白夜(能量转化一击斩)。"
          },
          {
            "id": "second-shift",
            "name": "第二形态(Second Shift)",
            "summary": "IS在驾驶员精神高度集中或危机时进化的强化形态。性能大幅提升，外观改变。白式第二形态机动力增强但消耗极快。"
          },
          {
            "id": "is-generation",
            "name": "IS世代体系",
            "summary": "第一世代:基本飞行装甲(千冬时代)。第二世代:多功能武器系统。第三世代:专用机+一击必杀。第四世代:折叠装甲+空间收纳(束的最新技术)。"
          },
          {
            "id": "third-form-white-tail",
            "name": "白式第三形态：白尾",
            "summary": "第11卷尾声/第12卷中出现的白式第三形态。拥有能量翅膀和整合式高端功能；第12卷中楯无、簪和真耶检查其“断剑行动”后归还的状态。"
          },
          {
            "id": "fourth-gen-seventh-princess",
            "name": "第四代IS：第七公主",
            "summary": "卢森堡第七公主艾莉丝使用的第四代IS。武装包括重力断奏权杖、A2/AD轰炸系统、重力护盾与天使之翼。"
          },
          {
            "id": "time-crystal",
            "name": "时间晶体",
            "summary": "第12卷提及卢森堡洞穴系统是时间晶体唯一来源，而时间晶体是IS核心的原材料。该设定来自linovelib本地保存第12卷文本。"
          }
        ],
        "factions": [
          {
            "id": "is-academy",
            "name": "IS学园",
            "summary": "世界唯一IS驾驶员培育机构，位于人工岛。学生约600人全为女性(除一夏)。各国代表候补生在此学习。教职员含前代表织斑千冬。"
          },
          {
            "id": "phantom-task",
            "name": "亡国机业(Phantom Task)",
            "summary": "国际IS恐怖/秘密组织。原文称“亡国机业（phantom·task）”，其行动部队“黑白化身”由斯可儿·谬赛尔率领。多次围绕IS学园、秘密舰、京都等事件行动。"
          },
          {
            "id": "national-representatives",
            "name": "各国代表候补生制度",
            "summary": "各国派遣至IS学园的精英IS驾驶员。持有专用第三世代IS和专属支援团队。包括:英国(西西莉亚)、中国(凰铃音)、法国(夏洛特)、德国(拉芙拉)、俄罗斯(塔妮亚)。"
          },
          {
            "id": "is-academy-student-council",
            "name": "IS学园学生会",
            "summary": "学园自治组织，会长更识楯无，副会长更识簪。掌握学园内部的非正式权力网络。"
          },
          {
            "id": "is-academy-staff",
            "name": "IS学园职员",
            "summary": "教师和行政人员，包括前IS驾驶员。"
          },
          {
            "id": "shinonono-family",
            "name": "筱之之家",
            "summary": "IS开发者的家族，筱之之道场。"
          },
          {
            "id": "orimura-family",
            "name": "织斑家",
            "summary": "一夏和千冬的家族，父母失踪。"
          },
          {
            "id": "dunois-corp",
            "name": "迪努亚公司",
            "summary": "法国IS开发企业，夏洛特父亲的公司。开发疾风之再诞等IS。与各国政府和亡国机业有复杂关系。"
          },
          {
            "id": "shinonono-tabane",
            "name": "筱之之束(独立开发者)",
            "summary": "IS的发明者。以个人身份开发了白式和IS核心技术。在IS学园地下有秘密机库。不属于任何组织，以自由意志行动。被称为\"天才科学家\"。"
          },
          {
            "id": "luxembourg",
            "name": "卢森堡",
            "summary": "第12卷新增舞台/势力。拥有时间晶体来源地位，艾莉丝作为卢森堡第七公主登场。"
          }
        ],
        "rules": [
          {
            "id": "female-only-rule",
            "name": "IS女性适配铁则",
            "summary": "常规认知中只有女性能启动IS；男性驾驶员一夏是震动全球的例外。"
          },
          {
            "id": "core-scarcity",
            "name": "核心稀缺",
            "summary": "IS核心数量有限，专用机配置是政治与军事资源。原创角色若持有专用机需解释国家/企业/束/非法势力来源。"
          },
          {
            "id": "academy-safety",
            "name": "学园安全与竞技规则",
            "summary": "日常战斗以训练、竞技、演习为主；绝对防御、裁判系统与教师介入防止无意义死亡。"
          },
          {
            "id": "national-interest",
            "name": "国家利益约束",
            "summary": "代表候补生不是纯个人战力，背后有国家、军方、企业和外交压力。"
          },
          {
            "id": "no-free-power",
            "name": "不免费突破规则",
            "summary": "新能力、One-off Ability、Package、AI进化和核心网络访问需要训练、事件、风险或来源解释。"
          }
        ],
        "locations": [
          {
            "id": "is-academy-island",
            "name": "IS学园（不属于任何国家的土地）",
            "summary": "原文明确称IS学园在法律上和国际上都是“不属于任何国家的土地”。不要写成“人工岛”，原文未出现该说法。"
          },
          {
            "id": "third-arena",
            "name": "第三竞技场",
            "summary": "IS实战训练和班级对抗赛专用场地。配备能量护盾和实弹模拟系统。"
          },
          {
            "id": "dormitory",
            "name": "一年级宿舍",
            "summary": "学生生活区。一夏和箒为室友(同室不同床)。男女区域分开，但一夏是唯一的例外。"
          },
          {
            "id": "goten-household",
            "name": "五反田家",
            "summary": "东京某处的一夏好友五反田弹的家。一夏偶尔来访。弹的妹妹兰在此生活。"
          },
          {
            "id": "classroom",
            "name": "一年级一班教室",
            "summary": "一夏的班级，29名女生+1名男生。"
          },
          {
            "id": "kendo-dojo",
            "name": "筱之之道场",
            "summary": "箒家经营的道场兼神社。一夏和箒的童年训练地。"
          },
          {
            "id": "shopping-district",
            "name": "学园购物区",
            "summary": "学生购买日常用品的区域。"
          }
        ],
        "events": [
          {
            "id": "class-league",
            "name": "班级对抗赛",
            "summary": "年度班级间IS实战对抗赛。各班代表一对一决斗，联赛积分制。一年级一夏代表一班。"
          },
          {
            "id": "silver-gospel-incident",
            "name": "银色福音事件",
            "summary": "暴走/异常IS“银色福音（silverio·gospel）”事件；后续文本中一夏看到圆的沉默西风第二形态时联想到银色福音。"
          },
          {
            "id": "phantom-task-raid",
            "name": "亡国机业袭击",
            "summary": "亡国机业及其行动部队黑白化身在后期卷中活动，包括秘密舰、京都等事件；斯可儿使用黄金黎明，织斑圆使用沉默西风/黑骑士。"
          },
          {
            "id": "mondo-grosso",
            "name": "MONDO GROSSO世界大赛",
            "summary": "IS驾驶员最高竞技舞台。织斑千冬在第一届全胜夺冠后突然退役。各国代表候补生以此为目标训练。"
          },
          {
            "id": "seaside-school",
            "name": "临海学校",
            "summary": "夏季海边集训活动。各国代表候补生共同参与。夏洛特与一夏关系进展的关键场景。"
          },
          {
            "id": "best-couple",
            "name": "最佳情侣大会",
            "summary": "学园祭活动。一夏与夏洛特、拉芙拉被配对参加。"
          },
          {
            "id": "sports-festival",
            "name": "体育祭",
            "summary": "全校运动会。引发各国代表候补生争夺一夏的\"所有权\"竞争。"
          },
          {
            "id": "kyoto-trip",
            "name": "京都修学旅行",
            "summary": "亡国机业在京都发动袭击。一夏与箒、铃共同应对。龙吻事件。"
          },
          {
            "id": "excalibur-kings-sword-incident",
            "name": "王者之剑/断剑行动",
            "summary": "第11卷事件。超凝聚等离子炮“王者之剑”失控并从轨道威胁地面；塞西莉亚、切尔西、白式第三形态“白尾”等卷入，最终形成“断剑行动”后的白式变化伏笔。"
          },
          {
            "id": "luxembourg-princess-incident",
            "name": "卢森堡第七公主事件",
            "summary": "第12卷事件。卢森堡第七公主艾莉丝抵达日本，涉及卢森堡、时间晶体、第四代IS“第七公主”与一夏争夺。"
          },
