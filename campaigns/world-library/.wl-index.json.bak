          },
          "阿瑟·川恩（Arthur Trine）": {
            "id": "char-阿瑟-川恩-Arthur-Trine",
            "name": "阿瑟·川恩（Arthur Trine）",
            "summary": "## 基本信息 - 生日：C.E.47年1月4日 - 年龄：26岁（SEED DESTINY）",
            "aliases": [
              "阿瑟·川恩（Arthur Trine）",
              "阿瑟",
              "川恩",
              "亚瑟"
            ],
            "factions": [],
            "powerSystems": [],
            "importance": "secondary",
            "sourceRefs": [
              "campaigns/world-library/imports/worldviews/gundam-seed/worldbooks/SEED_V1.0_card.worldbook.json",
              "worldbook-097-阿瑟·川恩（Arthur-Trine）"
            ]
          },
          "阿斯兰": {
            "id": "char-阿斯兰",
            "name": "阿斯兰",
            "summary": "【性别：男】【年龄：16岁】【血型：O型】【身高：170CM】【体重：63KG】【出生日期：C.E.55年10月29日】【出生地：PLANT（尤尼乌斯7）】【所属：扎夫特、独立部队永恒号】【职业：MS驾驶员、机械作业】【职业阶级：扎夫特红衣】【与青梅竹马对峙的扎夫特精英驾驶员】（前期）父亲是PLANT最高评议会议长的扎夫特新兵的壮烈战斗。C.E.71年1月25日，扎夫特的克鲁泽队袭击了奥布的资源卫星赫里奥波利斯，夺走了地球联合军的5架新型MS中的4架机体。在这场C.E.71年的扎夫特与地球联合军的战争中，一名精英驾驶员参加了这次作战行动。他就是PLANT国防委员长帕特里克·萨拉的儿子，也是PLANT歌姬拉克丝·克莱茵的未婚夫——阿斯兰·萨拉。对阿斯兰而言，这次作战行动是特别的。那是因为C.E.70年2月14日地球联合军和PLANT决定对立的“血之情人节”核攻击事件，阿斯兰失去了祖国的尤尼乌斯7号和母亲蕾诺雅·萨拉。怀着亲人去世的悲伤和愤怒，他参加了在赫里奥波利斯抢夺高达的作战。但是在那里，发生了让他感到困惑的事情，那就是与曾经在月面都市哥白尼的幼年学校认识基拉·大和的重逢。【选择与旧友共同战斗而脱离组织的青年的战斗】（后期）",
            "aliases": [
              "阿斯兰",
              "阿斯兰（CE71年）",
              "阿斯兰（CE73年）"
            ],
            "factions": [],
            "powerSystems": [],
            "importance": "primary",
            "sourceRefs": [
              "https://www.bilibili.com/opus/674518197160902676",
              "https://www.bilibili.com/opus/678029698045837313"
            ]
          },
          "阿斯兰·萨拉（Athrun Zala）": {
            "id": "char-阿斯兰-萨拉-Athrun-Zala",
            "name": "阿斯兰·萨拉（Athrun Zala）",
