      "world": {
        "powerSystems": [
          {
            "id": "ps-magecraft",
            "name": "魔术体系",
            "summary": "通过魔术回路将生命力转化为魔力，连接魔术基盘（神话/宗教/学术体系）施展术式。核心组件：魔术回路、魔术刻印、魔术基盘、魔力（大源Mana/小源Od）。"
          },
          {
            "id": "ps-true-magic",
            "name": "五大魔法",
            "summary": "超越魔术的'奇迹'——直接连接根源的法则干涉。现存：第二法（泽尔里奇，平行世界干涉）、第三法（爱因兹贝伦，灵魂物质化/天之杯）、第五法（苍崎青子，时间相关）。"
          },
          {
            "id": "ps-noble-phantasm",
            "name": "宝具系统",
            "summary": "从者持有、英雄传说结晶化的最终武装。需真名解放完全释放。分类：对人/对军/对城/对国/结界/对肃正/对界。"
          },
          {
            "id": "ps-servant-classes",
            "name": "从者职阶",
            "summary": "英灵召唤时装入的'容器'。基础七职阶：Saber/Archer/Lancer/Rider/Caster/Assassin/Berserker。额外职阶：Ruler/Avenger/Alterego/M"
          },
          {
            "id": "ps-heroic-spirit",
            "name": "英灵与从者系统",
            "summary": "英灵是死后升华为超越时间存在的灵魂本体，记录于英灵之座。从者是英灵本体的'分身'——复制情报装入职阶容器，与御主契约获取魔力。"
          },
          {
            "id": "ps-reality-marble",
            "name": "固有结界",
            "summary": "将使用者的心象世界具现化侵蚀现实的最高等级大魔术，接近魔法。维持消耗巨量魔力。案例：无限剑制(卫宫士郎)、王之军势(伊斯坎达尔)。"
          },
          {
            "id": "ps-mystic-eyes",
            "name": "魔眼",
            "summary": "通过视线干涉外界的异能。等级：普通→宝石→黄金→虹→神级。代表：直死之魔眼（两仪式/远野志贵），可看到万物'死之线'并沿线切割。"
          },
          {
            "id": "ps-dead-apostle",
            "name": "死徒与真祖",
            "summary": "死徒：被吸血种转变为不老不死的存在，划分为二十七祖。真祖：自然产生的吸血种，朱月（TYPE-MOON）为其原型。"
          },
          {
            "id": "ps-beast",
            "name": "人类恶 / Beast",
            "summary": "被人类史排斥的七个'人类爱'的灾厄。并非纯粹邪恶，而是'人类必须跨越的试炼'。冠位从者是针对Beast的专用对界武装。"
          },
          {
            "id": "ps-fairy-system",
            "name": "妖精体系（异闻带不列颠）",
            "summary": "妖精国不列颠的独特生命体系。妖精无寿命概念，诞生有'目的'，遗失目的则摩斯化。六大氏族，亚铃为始祖级存在。"
          }
        ],
        "factions": [
          {
            "id": "fac-mage-association",
            "name": "魔术协会",
            "summary": "管理魔术师、隐匿神秘的国际组织。总部时钟塔（伦敦）。三大分支：时钟塔（西欧）、阿特拉斯院（埃及）、彷徨海（北欧）。"
          },
          {
            "id": "fac-clock-tower",
            "name": "时钟塔十二学部",
            "summary": "魔术协会核心。分为全体基础科→十二学部的金字塔结构。君主（Lord）为最高位阶。矿石科为最大学部。"
          },
          {
            "id": "fac-holy-church",
            "name": "圣堂教会",
            "summary": "与魔术协会对抗的超凡组织。以抹除异端为天职。下辖埋葬机关（代行者/处刑人），使用黑键和洗礼咏唱。"
          },
          {
            "id": "fac-burial-agency",
            "name": "埋葬机关",
            "summary": "圣堂教会的实战派代行者组织。处理魔术协会无法处理的'超规格异端'。成员含代行者（言峰绮礼/米雷亚等）和处刑人。"
          },
          {
            "id": "fac-three-families",
            "name": "御三家",
            "summary": "冬木圣杯战争的创始家族：爱因兹贝伦（提供圣杯容器/第三法）、远坂（提供灵地）、间桐/玛奇里（构建令咒系统）。"
          },
          {
            "id": "fac-atlas-institute",
            "name": "阿特拉斯院",
            "summary": "魔术协会三大分支之一（埃及），以炼金术和未来预测为主。不参与常规魔术事务，专注'回避人类灭亡'的研究。"
          },
          {
            "id": "fac-el-melloi",
            "name": "艾尔梅罗派系",
            "summary": "时钟塔十二君主之一。矿石科象征。当前君主：莱妮丝·艾尔梅罗·阿奇佐尔缇（代理），实际运作由埃尔梅罗Ⅱ世（韦伯·维尔维特）主理。"
          }
        ],
        "rules": [
          {
            "id": "rule-root",
            "name": "根源之涡",
            "summary": "存在于所有次元之上的'万物之源'——记录一切事象的原因与结果。到达根源即全知全能。圣杯战争的最初目的为打开通往根源的孔。"
          },
          {
            "id": "rule-counter-force",
            "name": "抑止力",
            "summary": "地球或人类为回避'毁灭'命运的无意识安全装置。盖亚（地球意志）与阿赖耶（人类集体求生欲）。通过守护者（Counter Guardian）代行抹除威胁。"
          },
          {
            "id": "rule-throne",
            "name": "英灵之座",
            "summary": "存在于时间轴之外的'英灵数据库'。所有英雄灵魂死后被提升至此独立于时间流。英灵召唤是复制'情报'装入职阶容器。"
          },
          {
            "id": "rule-mystery",
            "name": "神秘",
            "summary": "基本法则——神秘在更强大的神秘面前无效化，且随科技发展整体衰退。神代魔术远强于现代魔术。"
          },
          {
            "id": "rule-holy-grail",
            "name": "圣杯战争",
            "summary": "七位魔术师（Master）召唤七骑英灵（Servant）进行至死方休的厮杀，胜者获得万能许愿器'圣杯'。实质为第三法·天之杯的大规模仪式。"
          }
        ],
        "locations": [
          {
            "id": "loc-fuyuki",
            "name": "冬木市",
            "summary": "日本地方都市。四次圣杯战争的舞台。关键地点：圆藏山（大圣杯所在）、柳洞寺、远坂邸、间桐邸、卫宫邸、穗群原学园、冬木教会、未远川。"
          },
          {
            "id": "loc-museum-street",
