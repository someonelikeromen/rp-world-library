              "https://www.bilibili.com/opus/714606064857776165"
            ]
          },
          "卡嘉莉·尤拉·阿斯哈（Cagalli Yula Athha）": {
            "id": "char-卡嘉莉-尤拉-阿斯哈-Cagalli-Yula-Athha",
