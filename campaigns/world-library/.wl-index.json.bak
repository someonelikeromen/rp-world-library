        "factions": [
          {
            "id": "fac-iu",
            "name": "伊·U（伊·幽）",
            "summary": "由世界顶级历史伟人后代组成的国际秘密结社，拥有核子潜艇东方号。首领夏洛克·福尔摩斯一世，围绕色金展开研究和争夺。极东战役后分裂为师团与眷属两大阵营。"
          },
          {
            "id": "fac-tokyo-butei",
            "name": "东京武侦高中",
            "summary": "位于东京湾学园岛上的武装侦探培训学校，设有强袭科、侦探科、狙击科、SSR等多个学科。故事主要舞台，主角团队的出身学校。由绿松武尊担任校长。"
          },
          {
            "id": "fac-baskerville",
            "name": "巴斯克维尔小队",
            "summary": "以远山金次为队长、亚莉亚为副队长的五人精英武侦小队。正式成立于第七卷新干线事件后。极东战役中作为师团阵营第一线战斗单位。小队名源自福尔摩斯经典案件。"
          },
          {
            "id": "fac-shidan",
            "name": "师团（Corps）",
            "summary": "极东战役中维护世界秩序的联盟，由伊·U钻研派余党、梵蒂冈圣女梅雅、玉藻、星伽巫女、自由石匠等组成。核心策略是通过外交与武力阻止第三次接轨。"
          },
          {
            "id": "fac-kenzoku",
            "name": "眷属（Retainers）",
            "summary": "极东战役中希望利用加速接轨改变世界的阵营，包括魔女连队、吸血鬼、鬼族等超自然种族。围绕壳金和色金展开争夺。内部并非铁板一块。"
          },
          {
            "id": "fac-n-org",
            "name": "N组织（诺亚/Nautilus）",
            "summary": "后期核心敌对组织，由莫里亚蒂教授领导，目标是引发第三次接轨使异世界列库忒亚与地球融合。拥有核子潜艇诺契勒斯号等舰队。成员佩戴代表阶级的N戒指。"
          },
          {
            "id": "fac-majo-regiment",
            "name": "魔女连队（Regiment Hexe）",
            "summary": "纳粹德国遗留的超自然魔女部队，由蕾芬洁上校创立。使用自然力魔法，曾与纳粹合作研发超自然武器。部分成员后倒向金次一方。"
          },
          {
            "id": "fac-blue-gang",
            "name": "蓝帮（Blue Gang）",
            "summary": "以香港为基地的国际犯罪组织，拥有海上堡垒蓝帮城。核心战力为眧眧四姊妹，与孙悟空（绯绯神碎片）有深度合作。后与金次关系转为亦敌亦友。"
          },
          {
            "id": "fac-zero-division",
            "name": "前公安零课",
            "summary": "日本政府废弃的超机密特务机关残党，专门处理超自然威胁。成员均为精英，拥有超越常规武侦的战力。后期与金次从敌对转为合作。"
          },
          {
            "id": "fac-g-bloodline",
            "name": "G的血族",
            "summary": "以远山金叉DNA为基础、经洛斯阿拉莫斯尖端科学研究所制造的人工天才系列。拥有远超常人的战斗力。远山五兄妹在后期结盟。"
          },
          {
            "id": "fac-giusto",
            "name": "Giusto（正义）",
            "summary": "GⅢ在罗马建立的英雄组织，本部设在卡斯特提亚城。成员以数字编号区分，核心为「一位数」。金次加入后获「武士零号」编号。"
          },
          {
            "id": "fac-oni-clan",
            "name": "鬼族",
            "summary": "日本传统妖怪族群，母系社会结构，女性成年后长犄角获得完整力量。最初作为N组织关联战力登场，后转为中立。与异世界列库忒亚有深层联系。"
          },
          {
            "id": "fac-lactea-guild",
            "name": "列库忒亚公会（Lactea Guild）",
            "summary": "从异世界列库忒亚来到地球的移民组建的秘密互助组织。成员通过魔法阵或自然形成的「门」穿越。对第三次接轨持不同立场（门派vs砦派）。"
          },
          {
            "id": "fac-freemasons",
            "name": "自由石匠（Freemasons）",
            "summary": "古老秘密结社，师团一方的重要盟友。拥有遍布全球的情报网络和财务资源。凯撒和L·华生为主要登场成员。"
          },
          {
            "id": "fac-sbz",
            "name": "杀巴宗（SBZ / Slay Baskerville）",
            "summary": "第四十五卷末新登场的敌对组织，全名「誓杀巴斯克维尔宗」。由朱帮武侠少女赵云带领，以逐个猎杀巴斯克维尔小队成员为目标。"
          },
          {
            "id": "fac-zhu-gang",
            "name": "朱帮",
            "summary": "与蓝帮并立的华人超自然武斗组织，以台湾台北为据点。成员包括武侠少女赵云等。杀巴宗极可能为其下属暗杀小队。"
          },
          {
            "id": "fac-vatican",
            "name": "梵蒂冈教廷驱魔体系",
            "summary": "拥有独立的驱魔师部队和圣遗物部队，对超自然力量持排斥立场。总体立场接近师团。"
          },
          {
            "id": "fac-ulus",
            "name": "乌鲁斯族",
            "summary": "成吉思汗（源义经）的一支血脉，全族仅存47名女性，世代守护璃璃色金。蕾姬是该族最后的末裔公主。"
          },
          {
            "id": "fac-arprosecutor",
            "name": "武装检察局（武检）",
            "summary": "监督武侦行为、调查武侦违法案件的特殊检察机关。武装检察官拥有高于常规武侦的权限。"
          },
          {
            "id": "fac-holmes-family",
            "name": "福尔摩斯家族",
            "summary": "夏洛克·福尔摩斯血脉传承的家族。亚莉亚为福尔摩斯4世，梅露爱特为福尔摩斯4世。家族与伊·U、伦敦武侦局有深厚关联。"
          },
          {
            "id": "fac-toyama-family",
            "name": "远山家",
            "summary": "传承HSS与色金武术的武侦名门。代代男性拥有爆发模式遗传体质，数百年作为「正义使者」战斗。家族成员分散全球各势力。"
          },
          {
            "id": "fac-hoshiga-family",
            "name": "星伽神社/星伽一族",
            "summary": "星伽一族世代守护星伽神社和绯绯色金的武装巫女家族。拥有鬼道术和色金杀女等传承力量。白雪为当代主要继承者。"
          },
          {
            "id": "fac-reunion",
            "name": "同窗会联盟（Reunion）",
            "summary": "夏洛克·福尔摩斯一世在第三十七卷召集的跨势力临时联盟，以第二届伊·U同学会名义召集。核心目标是夺回华生一世。"
          }
        ],
        "rules": [
          {
            "id": "rule-pov",
            "name": "第一人称有限视角",
            "summary": "严格以远山金次的第一人称叙事，读者所知≤金次所知。其他角色内心只能通过表情动作推断。"
          },
          {
            "id": "rule-hss-trigger",
            "name": "爆发模式必须有触发条件",
            "summary": "不能随意开启爆发模式，必须有性兴奋/极端情绪/濒死等明确触发条件，且有消耗代价。"
          },
          {
            "id": "rule-hss-duration",
            "name": "爆发模式持续时间限制",
            "summary": "通常仅持续数十分钟，解除后极度疲劳需长时间睡眠恢复。"
          },
          {
            "id": "rule-butei-law-9",
            "name": "武侦法第九条约束",
            "summary": "武侦不得杀害任何人，战斗必须以活捉/压制为目标。"
          },
          {
            "id": "rule-no-multi-pov",
            "name": "禁止多视角混切",
            "summary": "只能从金次视角感知战场全局，不能写其他角色内心独白。"
          },
          {
            "id": "rule-humour-switch",
            "name": "日常与战斗的快速切换",
            "summary": "日常喜剧用口语短句+内心吐槽；危机出现时瞬间转为紧张风格；战斗结束后立刻恢复吐槽模式。"
          }
        ],
        "locations": [
          {
            "id": "loc-tokyo-butei-high",
            "name": "东京武侦高中",
            "summary": "位于东京湾彩虹桥南方人工浮岛上的武装侦探培训学校，设强袭科、侦探科、狙击科、SSR等。全系列核心舞台。"
          },
          {
            "id": "loc-gakuenjima",
            "name": "学园岛",
            "summary": "南北长约2公里、东西宽约500公尺的人工浮岛，东京武侦高中所在地。北端有单轨电车浮岛北车站。"
          },
          {
            "id": "loc-iu-submarine",
            "name": "伊·U核潜艇（东方号）",
            "summary": "由大日本帝国海军与纳粹德国在二战期间合作建造的巨大核动力潜水航母，航速47节。舰内空间广阔，拥有教室、金库等设施。"
          },
          {
            "id": "loc-skytree",
            "name": "天空树（东京晴空塔）",
            "summary": "高634米的地标性电波塔。第九卷高潮战斗发生地——金次与华生激战、理子濒死事件、希尔达引发大规模停电。"
          },
          {
            "id": "loc-lambang-city",
            "name": "蓝帮城",
            "summary": "长约200米、宽约50米的三层漂浮海上堡垒。清朝以前蓝帮的移动基地，装饰金碧辉煌。第十四卷核心舞台。"
          },
          {
            "id": "loc-oni-no-kuni",
            "name": "鬼之国",
            "summary": "被茂密红树林覆盖的神秘孤岛，约200米见方。鬼族根据地，霸美统治。最后一枚壳金所在地，决定亚莉亚命运的关键地点。"
          },
          {
            "id": "loc-51-area",
            "name": "51区",
            "summary": "美国空军秘密基地，保管琉琉色金。GⅢ在此参与夺回琉琉色金的作战。"
          },
          {
            "id": "loc-lactea",
            "name": "列库忒亚（异世界）",
            "summary": "平行异世界，拥有精灵、妖精、魔兽等超自然生物。与地球之间存在接轨现象。N组织企图引发第三次接轨。"
          },
          {
            "id": "loc-shishimi-shrine",
            "name": "星伽神社",
            "summary": "星伽一族的根据地，世代武装巫女守护神体。供奉铭刀绯金菖蒲等神宝。白雪的故乡。"
          },
          {
            "id": "loc-red-crane-temple",
            "name": "红鹤寺",
            "summary": "列库忒亚公会活动据点，异世界移民在地球的秘密集会场所。"
          },
          {
            "id": "loc-giusto-castle",
            "name": "Giusto本部卡斯特提亚城",
            "summary": "GⅢ建立的英雄组织Giusto的总部，组织活动中心。"
          },
          {
            "id": "loc-benikan",
            "name": "红鸣馆",
            "summary": "德古拉伯爵弗拉德的西洋洋馆，铜墙铁壁的要塞。第三卷核心舞台，理子在此被囚禁。"
          },
          {
            "id": "loc-nautilus",
            "name": "诺契勒斯号（鹦鹉螺号）",
            "summary": "N组织的核子潜艇，由提督尼莫指挥。第三十六卷后脱离N组织升起初代尼莫旗帜。"
          },
          {
            "id": "loc-todai",
            "name": "东京大学本乡校区",
            "summary": "日本最高学府。金次在第四十五卷考上东大并参加入学典礼，武侦与高等教育体系在此接轨。"
          }
        ],
        "events": [
          {
            "id": "e000",
            "name": "武侦杀手连环事件",
            "summary": "针对武侦的连环犯罪，金次和亚莉亚相遇的契机。"
          },
          {
            "id": "e001",
            "name": "AN600劫机事件",
            "summary": "理子劫持客机，金次爆发模式迫降空地岛。"
          },
          {
            "id": "e002",
            "name": "极东战役宣战",
            "summary": "空地岛宣战会议，师团与眷属正式划分阵营。"
          },
          {
            "id": "e003",
            "name": "壳金七星破解",
            "summary": "希尔达破解亚莉亚体内壳金，七枚散落被眷属夺走。"
          },
          {
            "id": "e004",
            "name": "天空树决战",
            "summary": "金次vs华生，理子濒死，希尔达大规模停电。"
          },
          {
            "id": "e005",
            "name": "香港蓝帮城战役",
            "summary": "巴斯克维尔突破蓝帮城三层楼，决战孙悟空。"
          },
          {
            "id": "e006",
            "name": "龙之港决战",
            "summary": "师团逆转击败眷属大军，极东战役停战。"
          },
          {
            "id": "e007",
            "name": "鬼之国最终决战",
            "summary": "亚莉亚绯绯神化危机，最后一枚壳金回收。"
          },
          {
            "id": "e008",
            "name": "鄂霍次克海海战",
            "summary": "N舰队vs伊·U核潜艇的大规模海战。"
          },
          {
            "id": "e009",
            "name": "印度Reunion作战",
            "summary": "跨势力联盟解救华生一世，击败卡邦克鲁。"
          },
          {
            "id": "e010",
            "name": "杀巴宗狩猎开始",
            "summary": "赵云率领杀巴宗在东京大学入学典礼日发动袭击。"
          },
          {
            "id": "he-001",
            "name": "远山金叉假死真相",
            "summary": "金叉因对卒并发症进入假死，被美军消除记忆改造为顶级特务。"
          },
          {
            "id": "he-002",
            "name": "莫里亚蒂两千年真相",
            "summary": "莫里亚蒂教授是经历无数次接轨失败的永生协调者。"
          },
          {
            "id": "he-003",
            "name": "列库忒亚七女神命结",
            "summary": "莫里亚蒂通过命结之术从七位女神各获一条生命。"
          },
          {
            "id": "he-004",
            "name": "乌鲁斯族灭族真相",
            "summary": "蕾姬全族被曹操系势力屠杀殆尽。"
          }
        ],
        "timelines": [
          {
