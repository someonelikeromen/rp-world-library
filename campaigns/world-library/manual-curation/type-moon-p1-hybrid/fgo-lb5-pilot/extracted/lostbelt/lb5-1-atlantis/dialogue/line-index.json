  "dialogue": [
    {"dialogueId":"dlg-lb5-1-A1-001","timelineId":"evt-lb5-1-A1","speakerRaw":"尼莫","quoteRaw":"水兵就是我自己，也是将我的驾驶技能更为细化、特化的分身。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:27"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-A2-001","timelineId":"evt-lb5-1-A2","speakerRaw":"？？？","quoteRaw":"———哟。等你很久了，布鲁布克。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:30"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-A3-001","timelineId":"evt-lb5-1-A3","speakerRaw":"基尔什塔利亚","quoteRaw":"唯有英国异闻带是'绝对不能留下'的异闻带。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:33"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-A4-001","timelineId":"evt-lb5-1-A4","speakerRaw":"希翁","quoteRaw":"好了，去干脆利落地夺回地球吧！","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:36"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-B-001","timelineId":"evt-lb5-1-B","speakerRaw":"武藏","quoteRaw":"就算经历惨痛的失败，丧失一切，他们还是会留有能够卷土重来的性命。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:39"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-B1-001","timelineId":"evt-lb5-1-B1","speakerRaw":"奥德修斯","quoteRaw":"我定会杀死你们，直至确认到你们灭绝为止。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:42"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-B1-002","timelineId":"evt-lb5-1-B1","speakerRaw":"凯妮斯","quoteRaw":"我在这片海洋上是不死之身。我就是这样的存在。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:43"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-B2-001","timelineId":"evt-lb5-1-B2","speakerRaw":"俄里翁","quoteRaw":"亚特兰蒂斯真是太棒了。没有争斗，人类健康地生活着。……但只有一点，唯独那件事，是我无法容忍的。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:46"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-B2-002","timelineId":"evt-lb5-1-B2","speakerRaw":"巴沙洛缪","quoteRaw":"奥林波斯的诸神。他们仍存活的异闻带，就是这亚特兰蒂斯。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:47"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-B3-001","timelineId":"evt-lb5-1-B3","speakerRaw":"巴沙洛缪","quoteRaw":"你们要想闯进奥林波斯，就一定要突破这三道难关。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:50"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-C-001","timelineId":"evt-lb5-1-C","speakerRaw":"曼迪卡尔多","quoteRaw":"只要是我力所能及的，我什么都愿意做。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:53"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-C1-001","timelineId":"evt-lb5-1-C1","speakerRaw":"伊阿宋","quoteRaw":"仅仅两箭，那家伙就耗尽了『十二试炼』，和我们永别了！","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:56"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-C2-001","timelineId":"evt-lb5-1-C2","speakerRaw":"阿耳忒弥斯","quoteRaw":"这是为什么呢？我只觉得想要这样做。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:59"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-C2-002","timelineId":"evt-lb5-1-C2","speakerRaw":"俄里翁","quoteRaw":"怎么，你这不是会笑嘛。那你应该早点笑啦，否则太浪费了。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:60"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-C3-001","timelineId":"evt-lb5-1-C3","speakerRaw":"赫拉克勒斯岛居民","quoteRaw":"因身为缺陷品而被放逐出奥林波斯的我们，竟然能迎来如此美妙的结局———","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:63"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-C4-001","timelineId":"evt-lb5-1-C4","speakerRaw":"阿耳忒弥斯终端","quoteRaw":"露出笑容的你，更有价值。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:66"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-C4-002","timelineId":"evt-lb5-1-C4","speakerRaw":"伊阿宋","quoteRaw":"新生阿耳戈船英雄，出征！","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:67"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-D-001","timelineId":"evt-lb5-1-D","speakerRaw":"曼迪卡尔多","quoteRaw":"从者也不是为了让你感到悲伤才被召唤出来的。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:70"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-E-001","timelineId":"evt-lb5-1-E","speakerRaw":"赫淮斯托斯","quoteRaw":"英雄乃是吾等奥林波斯丧失已久的概念。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:73"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-F-001","timelineId":"evt-lb5-1-F","speakerRaw":"基尔什塔利亚","quoteRaw":"人类并不具备能选出正确答案的器官。我乃矫正这种错误之人。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:76"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-G-001","timelineId":"evt-lb5-1-G","speakerRaw":"阿斯特赖亚","quoteRaw":"妄图接近神的人类必须遭受惩罚。这是这个世界不可动摇的道理。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:79"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-H-001","timelineId":"evt-lb5-1-H","speakerRaw":"阿喀琉斯","quoteRaw":"只要你喜欢，再把我召唤出来就行了。无论多少次，我都愿意为你赴死！","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:82"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-I-001","timelineId":"evt-lb5-1-I","speakerRaw":"夏洛特·科黛","quoteRaw":"无论生前还是死后，从未帮上忙的我，第一次——帮上了世界的忙。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:85"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-J-001","timelineId":"evt-lb5-1-J","speakerRaw":"伊阿宋","quoteRaw":"受害者与加害者本来就会相互转换。如果一直在意这种事，还怎么当英雄啊！","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:88"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-J1-001","timelineId":"evt-lb5-1-J1","speakerRaw":"俄里翁","quoteRaw":"只要那家伙自称阿耳忒弥斯，就足以成为我拼上性命的理由。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:91"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-J2-001","timelineId":"evt-lb5-1-J2","speakerRaw":"伊阿宋","quoteRaw":"只有生者才有权利决定死者的末路！","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:94"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-J3-001","timelineId":"evt-lb5-1-J3","speakerRaw":"夏洛特·科黛","quoteRaw":"谢谢你们。让我喜欢上了我自己。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:97"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-K-001","timelineId":"evt-lb5-1-K","speakerRaw":"伊阿宋","quoteRaw":"无论手牌多烂，我还是有资格跟你赌上一局吧？奥德修斯。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:100"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-L-001","timelineId":"evt-lb5-1-L","speakerRaw":"伊阿宋","quoteRaw":"区区奥德修斯给老子滚，我们要怀着这种心态前进！","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:103"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-M-001","timelineId":"evt-lb5-1-M","speakerRaw":"阿喀琉斯","quoteRaw":"异闻带的喀戎。虽然老师于我有大恩……但你不是我的老师。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:106"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-N-001","timelineId":"evt-lb5-1-N","speakerRaw":"伊阿宋","quoteRaw":"望月千代女。你真的很努力。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:109"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-O-001","timelineId":"evt-lb5-1-O","speakerRaw":"夏洛特·科黛","quoteRaw":"请原谅我吧。毕竟这是我沉溺般的初恋啊。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:112"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-P-001","timelineId":"evt-lb5-1-P","speakerRaw":"巴沙洛缪","quoteRaw":"我确实将希望送达目的地了！","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:115"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-P-002","timelineId":"evt-lb5-1-P","speakerRaw":"赫克托耳","quoteRaw":"这是阿喀琉斯的请求嘛！","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:116"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-Q-001","timelineId":"evt-lb5-1-Q","speakerRaw":"曼迪卡尔多","quoteRaw":"我现在之所以这样做，并非因为我是从者。而是因为，我是你的朋友——————！","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:119"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-Q-002","timelineId":"evt-lb5-1-Q","speakerRaw":"俄里翁","quoteRaw":"我很自豪。不是为了你，而是为孕育出你这个人的所有历史感到自豪。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:120"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueId":"dlg-lb5-1-R-001","timelineId":"evt-lb5-1-R","speakerRaw":"伊阿宋","quoteRaw":"我们有决不能输的强大意志，发誓不到最后决不放弃勇往直前。","sourceRefs":["sources/worldbook-script/lostbelt/ch-097-lb5-1-atlantis.txt:123"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"}
  ]
}
