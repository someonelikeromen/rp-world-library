{
  "schema": "tm-fgo-dialogue-index-v1",
  "chapterId": "fgo-lb3-renzhi-tonghe-zhenguo",
  "dialogue": [
    {"dialogueRef":"lb3-dialogue-001","eventRef":"lb3-event-A","speakerRaw":"希翁","quoteRaw":"你们一定会存活下来。无论地球变成什么样，都不会放弃。必定，必定会重新振作起来。这么一来，我该做的事就很简单了——给你们提供新的基地。准备好第二迦勒底，并坚持等待你们。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:29"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-002","eventRef":"lb3-event-B","speakerRaw":"卡多克","quoteRaw":"那家伙啊，掩饰着颤抖的双腿，在拼命打肿脸充胖子。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:32"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-003","eventRef":"lb3-event-B","speakerRaw":"贝里尔","quoteRaw":"为什么你还活着呢，卡多克？","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:33"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-004","eventRef":"lb3-event-C","speakerRaw":"高扬斯卡娅","quoteRaw":"那蛋糕里的毒只有一人份。分成两半吃掉效果自然也会减半。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:36"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-005","eventRef":"lb3-event-D","speakerRaw":"达·芬奇","quoteRaw":"中国异闻带里有高扬斯卡娅的反应！","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:39"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-006","eventRef":"lb3-event-D","speakerRaw":"福尔摩斯","quoteRaw":"最优先目标变更为捕捉高扬斯卡娅。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:40"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-007","eventRef":"lb3-event-D","speakerRaw":"戈尔德鲁夫","quoteRaw":"新仇旧恨一起算，这次一定要让那名毒妇尝尝制裁的铁锤！","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:41"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-008","eventRef":"lb3-event-E","speakerRaw":"达·芬奇","quoteRaw":"尝试利用这片土地的灵脉与该异闻带的英灵座相连，但是毫无反应。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:44"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-009","eventRef":"lb3-event-E","speakerRaw":"芥雏子","quoteRaw":"为什么要来我的中国？那些家伙是追着你来的吧？真给人添麻烦。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:45"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-010","eventRef":"lb3-event-F","speakerRaw":"芥雏子","quoteRaw":"我不会憎恨、蔑视你们。这份厌恶，不值得浪费我的感情。我只会将你们当作害虫驱除。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:48"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-011","eventRef":"lb3-event-G","speakerRaw":"福尔摩斯","quoteRaw":"能令战争状态这一概念，甚至连武装的必然性，以及武器本身的相关知识都从民众的脑海中消失。简直就是理想的统治世界。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:51"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-012","eventRef":"lb3-event-H","speakerRaw":"斯巴达克斯","quoteRaw":"站稳身躯见证也是一种勇气可嘉的行为。少年啊，你很坚强，无需感到羞耻。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:54"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-013","eventRef":"lb3-event-I","speakerRaw":"斯巴达克斯","quoteRaw":"决不可心怀泛人类史才是应该存续下来那方的想法前进啊。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:57"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-014","eventRef":"lb3-event-I","speakerRaw":"斯巴达克斯","quoteRaw":"所谓的正义，往往只会在反叛与反叛的相互冲突中诞生。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:58"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-015","eventRef":"lb3-event-J","speakerRaw":"秦始皇","quoteRaw":"舍弃注定腐朽的肉身，以机械彻底代替朕之权能的结果，便是这圣躯。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:61"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-016","eventRef":"lb3-event-K","speakerRaw":"斯巴达克斯","quoteRaw":"我与我同胞流下的鲜血，或许有朝一日，会化作这样的笑容吧。这里，是离我过于遥远的理想世界。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:64"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-017","eventRef":"lb3-event-K","speakerRaw":"芥雏子","quoteRaw":"我不过是个流浪者。是只为与您相逢，才造访这个异闻带之人。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:65"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-018","eventRef":"lb3-event-L","speakerRaw":"福尔摩斯","quoteRaw":"在没有人心怀愿望的世界里，从者自然也不会出现。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:68"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-019","eventRef":"lb3-event-M","speakerRaw":"斯巴达克斯","quoteRaw":"人类啊，刮目仰望天空吧！这飞翔就是解放的极致！是颠覆大逆境的荒唐无理！自由的羽翼！","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:71"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-020","eventRef":"lb3-event-M","speakerRaw":"赤兔","quoteRaw":"人中吕布，马中赤兔！正因为人马一体的骁勇身姿过于脍炙人口，才会变成这副样貌了吧！也就是所谓的无辜的怪物。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:72"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-021","eventRef":"lb3-event-N","speakerRaw":"秦始皇","quoteRaw":"灵魂……不对，是所谓灵基的质量有着天壤之别。质量竟然将近十万吨，连朕都被吓傻了哦？","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:75"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-022","eventRef":"lb3-event-N","speakerRaw":"高扬斯卡娅","quoteRaw":"居然说什么化为岩石，我又不是孙悟空……","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:76"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-023","eventRef":"lb3-event-O","speakerRaw":"高扬斯卡娅","quoteRaw":"她整天嚷嚷着项羽、项羽的。这种程度的问题，你早就应该看穿了吧。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:79"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-024","eventRef":"lb3-event-O","speakerRaw":"芥雏子","quoteRaw":"过去，与我交谈却没有露出丝毫恐惧的那份胸襟……即便在历经漫长彷徨后的今日，仍是能令我内心平静的一段回忆。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:80"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-025","eventRef":"lb3-event-P","speakerRaw":"戈尔德鲁夫","quoteRaw":"这是生命与生命的冲突！所以，应该采用赌上命运的公平审判——只能猜拳了！","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:83"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-026","eventRef":"lb3-event-Q","speakerRaw":"虞姬","quoteRaw":"直到最后，都无人正确理解泛人类史中您的所作所为。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:86"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-027","eventRef":"lb3-event-Q","speakerRaw":"项羽","quoteRaw":"因此汝才会追寻我吗……不惜跨越悠久的时光。这是何等悲伤的彷徨。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:87"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-028","eventRef":"lb3-event-R","speakerRaw":"高扬斯卡娅","quoteRaw":"人类在其他历史中那些丑陋的傲慢，全都被秦始皇一个人吸收独占了。剩下的只有软弱无力、毫无价值的宠物。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:90"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-029","eventRef":"lb3-event-R","speakerRaw":"秦良玉","quoteRaw":"这片大地的安宁，是由那些甚至无法沉眠于骊山的阵亡将士们的鲜血换来的！在累累尸骸的另一侧，你们究竟会看到……多么血淋淋的未来呢。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:91"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-030","eventRef":"lb3-event-S","speakerRaw":"虞姬","quoteRaw":"我已经累了。我们就在这里，等待一切的结局吧。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:94"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-031","eventRef":"lb3-event-S","speakerRaw":"陈宫","quoteRaw":"倘若我手握如此庞大的魔力，想必就能挡住那家伙的去路吧。因为接下来的计策，就是让除我以外的在场全员，都用来自爆的说。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:95"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-032","eventRef":"lb3-event-T","speakerRaw":"项羽","quoteRaw":"又要留下汝孤身一人了……又要让汝彷徨不可终日了……虞兮，奈若何……","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:98"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-033","eventRef":"lb3-event-T","speakerRaw":"秦始皇","quoteRaw":"成为英灵吧，天仙之女啊。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:99"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"lb3-dialogue-034","eventRef":"lb3-event-T","speakerRaw":"秦始皇","quoteRaw":"嗯，朕是人。乃戴天履地之人。与汝等别无二致。朕已决定，在终焉之刻到来前，都要像这样……与汝等同在。","sourceRefs":["campaigns/world-library/manual-curation/type-moon-p1-hybrid/fgo-lb3-lb4-pilot/sources/worldbook-script/lostbelt/ch-095-lb3-renzhi-tonghe-zhenguo.txt:100"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"}
  ]
