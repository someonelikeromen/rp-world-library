{
  "schema": "tm-fgo-extracted-dialogue-set-v1",
  "chapterId": "fgo-lb6-2-round-table-post",
  "records": [
    {"recordId": "lb6-2-dialogue-001-nocknarea-event-A", "eventRecordId": "lb6-2-round-table-post-event-001-A-nocknarea-alliance-baobhan-sith-ambush", "speakerRaw": "诺克娜蕾", "quoteRaw": "梅布过于信任人类了。她与最爱的战士一同驰骋于沙场……可他却在最后关头死去了。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:28"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-002-doctor-event-B", "eventRecordId": "lb6-2-round-table-post-event-002-B-garden-of-lostwill-escape", "speakerRaw": "医生", "quoteRaw": "不要以游戏结束为目标，而是向游戏完成前进。度过一段可以自信地表示了无遗憾的人生。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:31"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-003-muryan-event-C", "eventRecordId": "lb6-2-round-table-post-event-003-C-last-knight", "speakerRaw": "缪瑞恩", "quoteRaw": "并不是我变大了，而是各位缩小了。小得就像你们迄今为止残忍踩扁的小虫子一样哦？", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:34"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-004-gareth-event-C", "eventRecordId": "lb6-2-round-table-post-event-003-C-last-knight", "speakerRaw": "加雷斯", "quoteRaw": "原来，是『镜之氏族』啊。是试图守护大家，免于毁灭的未来———却谁都没能拯救的，艾因塞尔———", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:35"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-005-oberon-event-D", "eventRecordId": "lb6-2-round-table-post-event-004-D-battle-eve-ii", "speakerRaw": "奥伯龙", "quoteRaw": "我不希望这些被人当做'理应消失的存在'。我希望人们能明白，就算中途结束，这些依然有意义。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:38"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-006-morgan-event-E", "eventRecordId": "lb6-2-round-table-post-event-005-E-morgan", "speakerRaw": "摩根", "quoteRaw": "我已经，不想再，失去，不列颠了……！", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:41"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-007-morgan-event-E", "eventRecordId": "lb6-2-round-table-post-event-005-E-morgan", "speakerRaw": "摩根", "quoteRaw": "我一定会拯救你。只有你，我一定要拯救。然后———这次一定，要让你幸福。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:42"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-008-nocknarea-event-F", "eventRecordId": "lb6-2-round-table-post-event-006-F-interlude", "speakerRaw": "诺克娜蕾", "quoteRaw": "摩根独自拼死召唤出了妖精国的妖精们，让他们活下去。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:45"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-009-bargest-event-F", "eventRecordId": "lb6-2-round-table-post-event-006-F-interlude", "speakerRaw": "巴格斯特", "quoteRaw": "我被这种生存方式与结局拯救了。也希望这妖精国也能变成如此。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:46"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-010-nocknarea-event-G", "eventRecordId": "lb6-2-round-table-post-event-007-G-coronation", "speakerRaw": "诺克娜蕾", "quoteRaw": "不。这个也是，我赢了哦，夜空的你。要说恋爱，我已经浅尝过啦。那是非常———非常美妙的，感受哦。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:49"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-011-grim-event-G", "eventRecordId": "lb6-2-round-table-post-event-007-G-coronation", "speakerRaw": "贤者格里姆", "quoteRaw": "那家伙刚才主动毁掉了最后的希望。虽说他应该没有意识到吧。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:50"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-012-percival-event-H", "eventRecordId": "lb6-2-round-table-post-event-008-H-doomsday", "speakerRaw": "珀西瓦尔", "quoteRaw": "『选定之枪』为了发挥真正的价值，会消耗持有者的寿命。……很抱歉，阿尔托莉雅。我今年16岁。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:53"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-013-merlin-event-H", "eventRecordId": "lb6-2-round-table-post-event-008-H-doomsday", "speakerRaw": "梅林", "quoteRaw": "放弃可不像你们的作风。接下来才是与不列颠对决真正的关键哦。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:54"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-014-merlin-event-I", "eventRecordId": "lb6-2-round-table-post-event-009-I-genesis-period", "speakerRaw": "梅林", "quoteRaw": "你们的『使命』是让六大氏族承认过错，并继承锻造圣剑的神秘。『巡礼之钟』代表氏族之长承认罪孽，而敲响所有钟的妖精将成为圣剑本身。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:57"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-015-artoria-event-J", "eventRecordId": "lb6-2-round-table-post-event-010-J-moment-a-star-is-born", "speakerRaw": "阿尔托莉雅", "quoteRaw": "无论是人类还是妖精，不列颠还是使命，我全都很讨厌。战斗很可怕，相互憎恨太累人了。平凡无奇的生活才是最快乐的。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:60"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-016-muramasa-event-J", "eventRecordId": "lb6-2-round-table-post-event-010-J-moment-a-star-is-born", "speakerRaw": "千子村正", "quoteRaw": "其实不需要用尽一切啦。既然还有未竟之事，就更不用说了。虽然仅剩最后收工份量的力量，但你就拿去为自己使用吧。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:61"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-017-fairy-knight-totorot-event-K", "eventRecordId": "lb6-2-round-table-post-event-011-K-midsummer-nights-dream", "speakerRaw": "妖精骑士特特洛特", "quoteRaw": "不要忘记咱，不要忘记梣，也不要忘记，咱们这美丽的不列颠。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:65"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-018-artoria-event-K", "eventRecordId": "lb6-2-round-table-post-event-011-K-midsummer-nights-dream", "speakerRaw": "阿尔托莉雅", "quoteRaw": "我，唯独不想辜负那一直以来都在闪耀着的微弱星光。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:66"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-2-dialogue-019-davinci-event-L", "eventRecordId": "lb6-2-round-table-post-event-012-L-end-britain-completed", "speakerRaw": "达·芬奇", "quoteRaw": "哪怕被当作不需要，再也无法从这个宇宙观测到，曾一度存在过的事物，如今也继续残留于星之记忆中。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-117-lb6-2-round-table-post.txt:69"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"}
  ],
