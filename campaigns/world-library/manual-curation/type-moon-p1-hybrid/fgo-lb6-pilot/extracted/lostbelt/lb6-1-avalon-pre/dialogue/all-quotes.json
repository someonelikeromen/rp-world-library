{
  "schema": "tm-fgo-extracted-dialogue-set-v1",
  "chapterId": "fgo-lb6-1-avalon-pre",
  "records": [
    {"recordId": "lb6-1-dialogue-001-ash-event-A", "eventRecordId": "lb6-1-avalon-pre-event-009-A-water-mirror-transfer", "speakerRaw": "梣", "quoteRaw": "你好，初次见面。我是梣，这位是特特洛特。在此相遇也是某种缘分。不介意的话，我们愿意帮助你哦。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:48"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-002-totorot-event-A", "eventRecordId": "lb6-1-avalon-pre-event-009-A-water-mirror-transfer", "speakerRaw": "特特洛特", "quoteRaw": "梣～，梣～～！不得了，这家伙不得了哦～！说的话不得了！极其莫名其妙！这家伙跟你一样，是魔术师哦～！", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:49"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-003-ash-event-B", "eventRecordId": "lb6-1-avalon-pre-event-010-B-ash-journey", "speakerRaw": "梣", "quoteRaw": "无论你做什么，女王历都不会发生改变……当你返回原本的时代时，决不可将一旦知晓便会产生矛盾的知识带回去。矛盾越大，你的记忆就会出现越大片的空白。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:52"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-004-ash-event-C", "eventRecordId": "lb6-1-avalon-pre-event-011-C-great-cavern", "speakerRaw": "梣", "quoteRaw": "怎么会这样———在洞底的是那家伙……！科尔努诺斯！但是为什么！？为什么凯尔特的古神会死在这种地方……！？", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:55"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-005-ash-event-D", "eventRecordId": "lb6-1-avalon-pre-event-012-D-miko-prophecy", "speakerRaw": "梣", "quoteRaw": "3600年来……每次结束后，我都被妖精们流放，遭到他们的排斥。从未拥有过什么和平的时光。我已经放弃对妖精们抱持希望了。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:58"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-006-totorot-event-E", "eventRecordId": "lb6-1-avalon-pre-event-013-E-end-fairy-calendar", "speakerRaw": "特特洛特", "quoteRaw": "孤身一人的『冬之战争』吗。抱歉没法陪你了，梣。可是战斗实在是太累了。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:61"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-007-ash-event-E", "eventRecordId": "lb6-1-avalon-pre-event-013-E-end-fairy-calendar", "speakerRaw": "梣", "quoteRaw": "我的真名是摩根。是怀着拯救这不列颠的使命，自星之内海漂流而至的乐园妖精阿瓦隆·勒·菲。同时，也是泛人类史中亚瑟王的仇敌，毁灭不列颠的魔女。更是遥远的未来中，你们迦勒底必须打倒的异闻带之王。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:62"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-008-sion-event-H", "eventRecordId": "lb6-1-avalon-pre-event-016-H-storm-border-departure", "speakerRaw": "希翁", "quoteRaw": "不列颠异闻带将在24小时后消灭。这场消灭会像海啸般席卷地球全域。行星会迎来大限，无法承受自身重力而压毁。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:69"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-009-oberon-event-I", "eventRecordId": "lb6-1-avalon-pre-event-017-I-cornwall-escape", "speakerRaw": "奥伯龙", "quoteRaw": "我的名字是奥伯龙。既是被人理召唤出来的英灵，也是这异闻带中唯一一骑肩负着帮助你们之命运的从者。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:73"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-010-oberon-event-J", "eventRecordId": "lb6-1-avalon-pre-event-018-J-salisbury-base", "speakerRaw": "奥伯龙", "quoteRaw": "放心吧，咕哒。这异闻带并不会毁灭在你手上。毕竟它正朝着自我毁灭的方向走去。我反倒认为，你这次是拯救的那方哦。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:77"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-011-fairy-knight-gawain-event-K", "eventRecordId": "lb6-1-avalon-pre-event-019-K-aurora-salisbury", "speakerRaw": "妖精骑士高文", "quoteRaw": "我名叫高文！妖精圆桌之一，不列颠的守护者！我将以陛下所赐的这个名字，彻底蹂躏你们这些家伙！", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:80"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-012-oberon-event-L", "eventRecordId": "lb6-1-avalon-pre-event-020-L-gloucester-auction", "speakerRaw": "奥伯龙", "quoteRaw": "摩根真正的目的是攻击泛人类史———让地球全境『妖精乡化』。扩大这妖精国，涂改泛人类史，令地球成为只存在不列颠岛的行星。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:84"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-013-oberon-event-M", "eventRecordId": "lb6-1-avalon-pre-event-021-M-wales-autumn-forest", "speakerRaw": "奥伯龙", "quoteRaw": "独揽责任不仅沉重，且对任何人都没有好处。反而会在关键时刻沉重到寸步难行。……不过根据你此前旅途的故事来看，你的内心早已变得哪儿都去不了了吧。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:88"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-014-oberon-event-N", "eventRecordId": "lb6-1-avalon-pre-event-022-N-dracae-river", "speakerRaw": "奥伯龙", "quoteRaw": "阿尔托莉雅一抵达，诺里奇就会毁灭。我是明知如此还带她过来的。……我这个引导者真是卑鄙无耻啊，甚至没让那些当事人做好思想准备。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:92"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-015-oberon-event-O", "eventRecordId": "lb6-1-avalon-pre-event-023-O-norwich-calamity-removal", "speakerRaw": "奥伯龙", "quoteRaw": "原本不应该存在这种机会才对的。『灾厄虽能被祓除，诺里奇依然毁灭』。这是预言中原有的一句话。只是我一直瞒着你们。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:95"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-016-holmes-event-P", "eventRecordId": "lb6-1-avalon-pre-event-024-P-postpart-storm-border", "speakerRaw": "福尔摩斯", "quoteRaw": "身为人类的存在方式，是作为阿尔托莉雅好姐姐的摩根。身为妖精的存在方式，是湖中妖精薇薇安。身为不列颠岛化身的存在方式，则是摩根·勒·菲。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:98"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-017-morgan-event-Q", "eventRecordId": "lb6-1-avalon-pre-event-025-Q-camelot-audience-morgan", "speakerRaw": "摩根", "quoteRaw": "我是你们的敌人。因此，自然没理由将神造兵装交给你们。若要拯救你们的世界，就打倒我吧。除此以外，别无拯救泛人类史的手段。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:101"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-018-artoria-event-R", "eventRecordId": "lb6-1-avalon-pre-event-026-R-londinium-round-table-army", "speakerRaw": "阿尔托莉雅", "quoteRaw": "我一个人是无法敲响诺里奇之钟的，所以，请大家助我一臂之力。这也是证明『圆桌军』并非人类的武装组织，而是以拯救不列颠为己任的，『预言之子』的同伴。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:104"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-019-oberon-event-S", "eventRecordId": "lb6-1-avalon-pre-event-027-S-wales-fairy-knight-gawain", "speakerRaw": "奥伯龙", "quoteRaw": "不过我想一个人待一会。不好意思，你们可以先回大道吗？毕竟向他们一个个道别需要一点时间。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:107"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-020-pepe-event-T", "eventRecordId": "lb6-1-avalon-pre-event-028-T-londinium-battle-eve", "speakerRaw": "佩佩隆伯爵", "quoteRaw": "妖精国的妖精能够移居到泛人类史那边。也就是存在携手共进的未来哦。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:110"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-021-davinci-event-T", "eventRecordId": "lb6-1-avalon-pre-event-028-T-londinium-battle-eve", "speakerRaw": "达·芬奇", "quoteRaw": "———科尔努诺斯。是凯尔特古神的名字。……这就是这妖精国曾经存在过神明的佐证哦。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:111"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-022-percival-event-U", "eventRecordId": "lb6-1-avalon-pre-event-029-U-londinium-defense-woodwose", "speakerRaw": "珀西瓦尔", "quoteRaw": "…………永别了，父亲。这份罪孽的报应，定会于乐园，降临。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:114"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-023-baobhan-sith-event-V", "eventRecordId": "lb6-1-avalon-pre-event-030-V-gloucester-fairy-ball", "speakerRaw": "芭万·希", "quoteRaw": "为什么赢不了！？分明我，分明只有我才是母亲大人的女儿啊！……只要从母亲大人的玉座拿出『庭』不就行了嘛。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:117"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-024-bargest-event-W", "eventRecordId": "lb6-1-avalon-pre-event-031-W-manchester-bargest-alliance", "speakerRaw": "巴格斯特", "quoteRaw": "贝里尔·伽特来到妖精国不过是数月前的事。而摩根陛下则是活了2000年的大妖精。这说不通啊。", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:120"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-025-fairy-knight-lancelot-event-X", "eventRecordId": "lb6-1-avalon-pre-event-032-X-albion-lake-district", "speakerRaw": "妖精骑士兰斯洛特", "quoteRaw": "我的真名是梅柳齐娜。昏暗沼泽的梅柳齐娜！是承蒙最美丽妖精赐名的，阿尔比恩的末裔！", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:123"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-026-mirror-event-X", "eventRecordId": "lb6-1-avalon-pre-event-032-X-albion-lake-district", "speakerRaw": "米拉", "quoteRaw": "『最终，预言之子将会来访两次。第一次是为了生，而第二次则是为了死。』", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:124"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"},
    {"recordId": "lb6-1-dialogue-027-artoria-event-Y", "eventRecordId": "lb6-1-avalon-pre-event-033-Y-orkney-mash-return-truth", "speakerRaw": "阿尔托莉雅", "quoteRaw": "所谓的『乐园妖精』，名副其实，就是星之内海……阿瓦隆派来的妖精。我诞生时只听到一个声音。『赶赴不列颠，纠正错误吧。』", "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:127"], "sourceType": "user-file-worldbook-script", "credibility": "B", "canonStatus": "canon-like"}
  ],
  "sourceRefs": ["sources/worldbook-script/lostbelt/ch-100-lb6-1-avalon-pre.txt:47-127"],
