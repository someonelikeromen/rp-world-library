{
  "schema": "tm-fgo-dialogue-index-v1",
  "chapterId": "fgo-eor-salem",
  "quotes": [
    {"dialogueRef":"salem-dlg-001","eventId":"salem-event-a","speaker":"美狄亚","line":"我被人动了手脚，一直在沉睡！那是变装……是拟态啊！","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":41,"lineEnd":41}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-002","eventId":"salem-event-b","speaker":"美狄亚","line":"不行，咕哒。现在不能干涉。不然连你也会被卷进去的。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":44,"lineEnd":44}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-003","eventId":"salem-event-b","speaker":"拉维尼娅","line":"你们使用了『魔术』，杀死了野兽们。我会全部，说出去的。我都，看到了。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":45,"lineEnd":45}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-004","eventId":"salem-event-c","speaker":"桑松","line":"绞刑已经执行了。我们没能赶上。提图芭已经死了。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":48,"lineEnd":48}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-005","eventId":"salem-event-c","speaker":"拉维尼娅","line":"已经，开始了。只会，被水面盛开的花，夺去，注意力，忘记了，沼泽下，腐烂的淤泥。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":49,"lineEnd":49}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-006","eventId":"salem-event-d","speaker":"喀耳刻","line":"咕哒，你我现在同生死共命运。在这塞勒姆的异常事态被消除前，我们谁都无法逃离这里。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":52,"lineEnd":52}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-007","eventId":"salem-event-d","speaker":"桑松","line":"如果阁下是裁决之人的话！就更应该相信人们的理性。绝不能让他们内心阴暗处出现恶魔，出现虚伪的魔女！","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":53,"lineEnd":53}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-008","eventId":"salem-event-e","speaker":"喀耳刻","line":"我们的干涉被贪婪地……有时甚至被巧妙地利用了。假如死刑犯没有接受制裁直接逃亡，我们就再也无法与玛修重逢了。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":56,"lineEnd":56}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-009","eventId":"salem-event-f","speaker":"桑松","line":"魔神柱不可能召唤迦勒底的人！召唤我们的人，并不是魔神柱！","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":59,"lineEnd":59}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-010","eventId":"salem-event-f","speaker":"霍普金斯","line":"将这本书带来，并坦白罪行的人的名字，是拉维尼娅·维特利。而隐瞒罪行之人的名字是———阿比盖尔·威廉姆斯。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":60,"lineEnd":60}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-011","eventId":"salem-event-g","speaker":"梅菲斯托费勒斯","line":"地狱乃是神不在的地方。倘若其原本，就完全不需要人类的话……那就是本质上根本上异常异质之神。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":63,"lineEnd":63}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-012","eventId":"salem-event-g","speaker":"桑松","line":"是我———将阁下———玛窦·霍普金斯被刺杀。这事态……几乎可以说是由我引起。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":64,"lineEnd":64}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-013","eventId":"salem-event-h","speaker":"卡特（魔神柱）","line":"'痛苦'才是人类幸福的基板。是绝对价值。远比'爱'或'死'更为贵重。阿比盖尔将会成为启蒙的巫女。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":67,"lineEnd":67}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-014","eventId":"salem-event-h","speaker":"卡特（魔神柱）","line":"在这塞勒姆，没有一个人不是心甘情愿的。就连你们，也都符合条件。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":68,"lineEnd":68}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-015","eventId":"salem-event-i","speaker":"魔神劳姆","line":"'真实'是无法拯救人类的。我要将这疯狂、这无稽之谈化为现实。借助来自虚空的降临者之手，终结人类。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":71,"lineEnd":71}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-016","eventId":"salem-event-i","speaker":"拉维尼娅","line":"在，牧草地……一起，眺望……大海……再……两个人一起，看鲸……","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":72,"lineEnd":72}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-017","eventId":"salem-event-j","speaker":"阿比盖尔","line":"如果你们能再次见到我，请一定要好好疼爱我哦？我偶尔会变成坏孩子……到那时，请一定要好好叱责我哦……","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":75,"lineEnd":75}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-018","eventId":"salem-event-j","speaker":"示巴女王","line":"在沙漠的另一头，也是有着绿洲的哦。请拿出迦勒底子民的风范，不要迷失星辰，昂首挺胸地走下去吧。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":76,"lineEnd":76}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-019","eventId":"salem-event-k","speaker":"美狄亚","line":"尽管你教我的东西基本没派上用处，但还算是成了我的慰藉……","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":79,"lineEnd":79}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-020","eventId":"salem-event-l","speaker":"哪吒","line":"齐天大圣……你这傻猴子。我稍微有些生气了。曾经与我不分上下的仙猴居然会打不过那种蛮不讲理的魔王……","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":82,"lineEnd":82}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"salem-dlg-021","eventId":"salem-event-l","speaker":"三藏","line":"我相信悟空与佛祖的佑护！我们可不能放弃！只要不放弃，一定能找到生路！","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-092-salem.txt","lineStart":83,"lineEnd":83}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"}
  ],
