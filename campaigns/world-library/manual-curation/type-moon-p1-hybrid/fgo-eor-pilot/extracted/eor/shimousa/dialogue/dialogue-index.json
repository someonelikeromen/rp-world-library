  "quotes": [
    {"dialogueRef":"shimousa-dlg-001","eventId":"shimousa-event-a","speaker":"岩窟王","line":"闭嘴。……别再说了。对我来说毫无必要。你只要保持沉默就行了，夏洛克·福尔摩斯。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-091-shimousa.txt","lineStart":41,"lineEnd":41}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-002","eventId":"shimousa-event-a","speaker":"武藏","line":"好久不见，咕哒！我俩能平安无事地再次见面，真令人高兴！","sourceRefs":[{"lineStart":42,"lineEnd":42}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-003","eventId":"shimousa-event-b","speaker":"武藏","line":"不用去看这些断绝之命。不用去听这些撕裂之声。顺带一提，也别看我挥剑。","sourceRefs":[{"lineStart":45,"lineEnd":45}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-004","eventId":"shimousa-event-b","speaker":"胤舜","line":"贫僧，名为宝藏院胤舜！是从宝藏院流枪术之开山祖师胤荣大人那里亲自获授僧人教诲与枪之教诲之人是也！","sourceRefs":[{"lineStart":46,"lineEnd":46}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-005","eventId":"shimousa-event-c","speaker":"Saber Empireo","line":"何其可悲，吾之剑已然超越神佛，抵达至高天。放弃吧，宝藏院。","sourceRefs":[{"lineStart":49,"lineEnd":49}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-006","eventId":"shimousa-event-c","speaker":"Caster Limbo","line":"一切鏖杀之宿业。好啦，该为你埋入什么呢！","sourceRefs":[{"lineStart":50,"lineEnd":50}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-007","eventId":"shimousa-event-c","speaker":"胤舜","line":"快逃，武藏、阿缝、田助。快逃，一直逃下去，立香。……别被追上。决不能。","sourceRefs":[{"lineStart":51,"lineEnd":51}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-008","eventId":"shimousa-event-d","speaker":"Lancer Purgatorio","line":"多亏你们躲藏起来，我才能好好滋润了一番我的枪！","sourceRefs":[{"lineStart":54,"lineEnd":54}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-009","eventId":"shimousa-event-d","speaker":"武藏","line":"在三十二次中，有三十一次。死的是我。","sourceRefs":[{"lineStart":55,"lineEnd":55}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-010","eventId":"shimousa-event-d","speaker":"村正","line":"老夫所追求的，乃是清算怨恨——斩断因缘、斩断宿命、斩断宿业的名刀。","sourceRefs":[{"lineStart":56,"lineEnd":56}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-011","eventId":"shimousa-event-e","speaker":"Archer Inferno","line":"全都全都燃烧殆尽吧！如若此世并非地狱，那将此世化为地狱不就合乎道理了吗？","sourceRefs":[{"lineStart":59,"lineEnd":59}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-012","eventId":"shimousa-event-e","speaker":"村正","line":"老夫所追求的究极的一刀，并非削肉断骨之刃。这种事其他东西都能做到吧。","sourceRefs":[{"lineStart":60,"lineEnd":60}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-013","eventId":"shimousa-event-f","speaker":"Archer Inferno","line":"因为我恨啊。憎恨、憎恨得难以自已。由我自己化为薪柴。","sourceRefs":[{"lineStart":63,"lineEnd":63}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-014","eventId":"shimousa-event-f","speaker":"Caster Limbo","line":"杀得越多，就能募集得越多。沾染怨恨嫉妒悲哀的灵魂越多越好。","sourceRefs":[{"lineStart":64,"lineEnd":64}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-015","eventId":"shimousa-event-g","speaker":"巴御前","line":"背对夕阳微笑着的义仲大人的侧脸，呜呼，为何，巴会忘了呢——","sourceRefs":[{"lineStart":67,"lineEnd":67}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-016","eventId":"shimousa-event-g","speaker":"Archer Inferno","line":"太好了……巴已经，不用再化身为薪柴了吧……","sourceRefs":[{"lineStart":68,"lineEnd":68}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-017","eventId":"shimousa-event-h","speaker":"武藏","line":"超越抵达了至高之一手的新免无二斋，位于一之前方的——'零'之剑。","sourceRefs":[{"lineStart":71,"lineEnd":71}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-018","eventId":"shimousa-event-h","speaker":"众合地狱","line":"去杀戮吧。去吞噬吧。反正，此世终为梦幻。","sourceRefs":[{"lineStart":72,"lineEnd":72}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-019","eventId":"shimousa-event-i","speaker":"Assassin Paraiso","line":"吾等并非英灵本身，而是犹如英灵尸骸般的存在！但却是最强且无敌的尸骸！","sourceRefs":[{"lineStart":75,"lineEnd":75}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-020","eventId":"shimousa-event-i","speaker":"清姬","line":"能让咕哒大人来保护我……我高兴得快死了……","sourceRefs":[{"lineStart":76,"lineEnd":76}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-021","eventId":"shimousa-event-j","speaker":"Assassin Paraiso","line":"谁都没有惩罚我！既然如此，我又该如何是好！？","sourceRefs":[{"lineStart":79,"lineEnd":79}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-022","eventId":"shimousa-event-j","speaker":"武藏","line":"再见了。但愿下次你能遇见说这份迷惘与泪水便是对你的惩罚之人。","sourceRefs":[{"lineStart":80,"lineEnd":80}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-023","eventId":"shimousa-event-k","speaker":"Rider黑绳地狱","line":"所谓人类，与稻草卷也没什么差别。所谓世间，也就是稻草的集合体。","sourceRefs":[{"lineStart":83,"lineEnd":83}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-024","eventId":"shimousa-event-k","speaker":"众合地狱","line":"不听大人话的孩子呀——可是会被鬼，吃掉的哦？","sourceRefs":[{"lineStart":84,"lineEnd":84}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-025","eventId":"shimousa-event-l","speaker":"Rider黑绳地狱","line":"我不会让你在我眼前死去。……这不就像是我吗。为了保护弟弟，如此拼命努力。","sourceRefs":[{"lineStart":87,"lineEnd":87}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-026","eventId":"shimousa-event-l","speaker":"村正","line":"你是被幸福地抚养长大的。……若像你这样的小家伙逐渐增多的日子能到来，太平盛世也并非那么不济呢。","sourceRefs":[{"lineStart":88,"lineEnd":88}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-027","eventId":"shimousa-event-m","speaker":"众合地狱","line":"恶鬼取得胜利的故事……应该没人，愿意听吧……即便如此，妾身也——挣扎过——努力过了哦？","sourceRefs":[{"lineStart":91,"lineEnd":91}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-028","eventId":"shimousa-event-m","speaker":"Rider黑绳地狱","line":"正因为我是这种无可救药的女人，才能……没有下手杀害那孩子。","sourceRefs":[{"lineStart":92,"lineEnd":92}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-029","eventId":"shimousa-event-n","speaker":"天草四郎","line":"不会原谅……将以厌离秽土城之威光，平息我的怨恨！","sourceRefs":[{"lineStart":95,"lineEnd":95}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-030","eventId":"shimousa-event-n","speaker":"村正","line":"因为他们对小家伙们出手了。既然那群化生的老大在那里，就得好好和他算清这笔账。","sourceRefs":[{"lineStart":96,"lineEnd":96}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-031","eventId":"shimousa-event-o","speaker":"段藏","line":"请各位一定要相信我。现在的我，是凭自己的意志站在这里的。","sourceRefs":[{"lineStart":99,"lineEnd":99}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-032","eventId":"shimousa-event-o","speaker":"段藏","line":"小太郎阁下……终有一日，一定……会与您——在某处见面，是吧……？","sourceRefs":[{"lineStart":100,"lineEnd":100}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-033","eventId":"shimousa-event-p","speaker":"村正","line":"吾身所追求的，乃是对怨恨的清算。斩断因缘、斩断命运、斩断宿业——从宿业中的解放。","sourceRefs":[{"lineStart":103,"lineEnd":103}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-034","eventId":"shimousa-event-p","speaker":"武藏","line":"吾之奥义，于此开眼。……感激不尽，但马守。","sourceRefs":[{"lineStart":104,"lineEnd":104}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shimousa-dlg-035","eventId":"shimousa-event-q","speaker":"武藏","line":"和你一起战斗的我一定，大概——成了一位锄强扶弱的正义的剑士吧。","sourceRefs":[{"lineStart":107,"lineEnd":107}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
