  "quotes":[
    {"dialogueRef":"agartha-dlg-001","eventId":"agartha-event-a","speaker":"玛修","line":"可以说现在迦勒底所有的观测仪器，都是我献给前辈的盾。","sourceRefs":[{"path":"sources/worldbook-script/eor/ch-090-agartha.txt","lineStart":45,"lineEnd":45}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-002","eventId":"agartha-event-a","speaker":"达·芬奇","line":"曾在时间神殿与我们战斗过，却从七十二柱魔神集合中剥离的特使。在萌生了自我之后，背叛了统括局盖提亚，凭借各自的意志散落于世界各地的兽之残滓。","sourceRefs":[{"lineStart":46,"lineEnd":46}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-003","eventId":"agartha-event-b","speaker":"弗格斯","line":"这种绝对的信任感——一定是并非我的另一个我所结下的缘分吧。","sourceRefs":[{"lineStart":49,"lineEnd":49}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-004","eventId":"agartha-event-b","speaker":"弗格斯","line":"我的心脏现在跳得非常快，仿佛在说我应该与各位同行。","sourceRefs":[{"lineStart":50,"lineEnd":50}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-005","eventId":"agartha-event-c","speaker":"弗格斯","line":"锻炼明确易懂。能让我不再关注于多余的杂念，以及那些令我烦恼的与兄弟们的不和。","sourceRefs":[{"lineStart":53,"lineEnd":53}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-006","eventId":"agartha-event-c","speaker":"弗格斯","line":"我无法对女性挥剑。","sourceRefs":[{"lineStart":54,"lineEnd":54}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-007","eventId":"agartha-event-d","speaker":"Berserker女王","line":"一个人完事后接下一个，下一个完事后再来一个。你们会成为只能向胎内尚空的女人播种的存在。","sourceRefs":[{"lineStart":57,"lineEnd":57}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-008","eventId":"agartha-event-d","speaker":"Berserker女王","line":"啊啊终于能杀了总算能杀了一定要杀无数次杀掉击杀碾杀捏杀劈杀绞杀碎尸万段咬成碎片！","sourceRefs":[{"lineStart":58,"lineEnd":58}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-009","eventId":"agartha-event-e","speaker":"Rider","line":"逃跑并不是失败。停滞也不是失败。甚至连失败都不是失败。只要不放弃目标，前面说的都意味着前进。","sourceRefs":[{"lineStart":61,"lineEnd":61}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-010","eventId":"agartha-event-e","speaker":"Rider","line":"永不言弃地战斗下去。只要这么做，迟早能获得胜利。","sourceRefs":[{"lineStart":62,"lineEnd":62}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-011","eventId":"agartha-event-f","speaker":"女海盗","line":"想要的东西就亲手去抢夺！这才是一无所有的我们的规范！也是伊苏的支配者，海盗公女大人赐予吾等的美妙宗旨！","sourceRefs":[{"lineStart":65,"lineEnd":65}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-012","eventId":"agartha-event-f","speaker":"Rider","line":"至少要将这件事化为前进的食粮——否则死在这里的家伙们也不会瞑目的。","sourceRefs":[{"lineStart":66,"lineEnd":66}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-013","eventId":"agartha-event-g","speaker":"Rider","line":"资源是有限的。所有东西都会被消耗。届时剩下的只有无。甚至连你都会吞噬的无。","sourceRefs":[{"lineStart":69,"lineEnd":69}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-014","eventId":"agartha-event-g","speaker":"Assassin","line":"毁灭敌国根本不需要这种东西。只要一把小小的钥匙就够了吧！","sourceRefs":[{"lineStart":70,"lineEnd":70}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-015","eventId":"agartha-event-h","speaker":"Rider","line":"不知何时会出现，特地去找的话又会突然消失。那无疑是令人不禁浑身颤抖的危险。","sourceRefs":[{"lineStart":73,"lineEnd":73}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-016","eventId":"agartha-event-i","speaker":"周照","line":"朕是靠朕的双腿站上了这里。除朕以外，没人能让朕——卑躬屈膝！","sourceRefs":[{"lineStart":76,"lineEnd":76}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-017","eventId":"agartha-event-i","speaker":"立香","line":"没有笑容的这座城市，是错误的。","sourceRefs":[{"lineStart":77,"lineEnd":77}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-018","eventId":"agartha-event-j","speaker":"山鲁佐德","line":"我不想死。我的愿望，仅此而已。","sourceRefs":[{"lineStart":80,"lineEnd":80}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-019","eventId":"agartha-event-j","speaker":"Rider","line":"这里的存在方式一目了然。男人从地表掉下来，女人利用他们的种增加女人的世界。肯定这种现状的家伙，才应该是魔神柱。","sourceRefs":[{"lineStart":81,"lineEnd":81}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-020","eventId":"agartha-event-k","speaker":"Berserker","line":"弱小的敌人是让吾等英勇名扬天下的食粮。强大的敌人是磨练吾等武艺的食粮。——咆哮吧。","sourceRefs":[{"lineStart":84,"lineEnd":84}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-021","eventId":"agartha-event-k","speaker":"Berserker","line":"唯有希腊的英雄不算在内——！","sourceRefs":[{"lineStart":85,"lineEnd":85}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-022","eventId":"agartha-event-l","speaker":"Rider/哥伦布","line":"那又如何。我们还活着。还能靠自己的双腿行走。","sourceRefs":[{"lineStart":88,"lineEnd":88}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-023","eventId":"agartha-event-l","speaker":"彭忒西勒亚","line":"杀，杀，绝对要，杀了你——阿喀琉斯！！！","sourceRefs":[{"lineStart":89,"lineEnd":89}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-024","eventId":"agartha-event-m","speaker":"哥伦布","line":"我对自己的顽固与好运很有自信。或者说这是我唯一的优点！","sourceRefs":[{"lineStart":92,"lineEnd":92}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-025","eventId":"agartha-event-m","speaker":"山鲁佐德","line":"这个玉匣，是能实现愿望的东西。类似一次性简易愿望机。","sourceRefs":[{"lineStart":93,"lineEnd":93}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-026","eventId":"agartha-event-n","speaker":"彭忒西勒亚","line":"你这家伙，甚至从未将在你眼前战斗的我当做一名战士来看待！","sourceRefs":[{"lineStart":96,"lineEnd":96}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-027","eventId":"agartha-event-n","speaker":"达·芬奇","line":"伟大的航海家，也是奴隶商人、虐杀者。","sourceRefs":[{"lineStart":97,"lineEnd":97}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-028","eventId":"agartha-event-o","speaker":"哥伦布","line":"女人会无限增加！能卖出好价钱！","sourceRefs":[{"lineStart":100,"lineEnd":100}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-029","eventId":"agartha-event-o","speaker":"山鲁佐德","line":"故事，就此完成。十分感谢——","sourceRefs":[{"lineStart":101,"lineEnd":101}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-030","eventId":"agartha-event-p","speaker":"山鲁佐德","line":"你们一直，都在我的'一千零一夜'里面哦。","sourceRefs":[{"lineStart":104,"lineEnd":104}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-031","eventId":"agartha-event-p","speaker":"山鲁佐德","line":"我——是不想死。只要存在，就必须死。唯有破坏世界。","sourceRefs":[{"lineStart":105,"lineEnd":105}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"agartha-dlg-032","eventId":"agartha-event-q","speaker":"弗格斯","line":"笑吧，与死亡的命运不断抗争的强大女人啊。'不断渴望着不想死'的死相，看上去未免有些难看哦！","sourceRefs":[{"lineStart":108,"lineEnd":108}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"}
  ],
