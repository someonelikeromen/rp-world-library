{
  "schema": "tm-fgo-dialogue-index-v1",
  "chapterId": "fgo-eor-shinjuku",
  "sourceType": "user-file-worldbook-script",
  "credibility": "B",
  "canonStatus": "canon-like",
  "quotes": [
    {"dialogueRef":"shinjuku-dlg-001","eventId":"shinjuku-event-a","speaker":"工作人员B","line":"最糟的情况，莫过于可能无视我们的所有功绩，冻结迦勒底，并进行封印处理，也包括人员。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":43,"lineEnd":43}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-002","eventId":"shinjuku-event-a","speaker":"工作人员B","line":"所以要趁现在，哪怕能修正一丁点那孩子的情报也好。……我们起码也该守护一下那孩子的未来吧。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":44,"lineEnd":44}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-003","eventId":"shinjuku-event-b","speaker":"新宿的Archer","line":"善人几乎都死光了，只有特级恶人才能活下来的真正世纪末风景。与外界隔绝的监狱都市，魔境、魔乡，以及令人厌恶的恶都。换言之——我们将这里称作，隔绝魔境新宿！","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":47,"lineEnd":47}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-004","eventId":"shinjuku-event-b","speaker":"新宿的Archer","line":"这个特异点啊，是个暴露真名就可能会送命的场所。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":48,"lineEnd":48}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-005","eventId":"shinjuku-event-c","speaker":"新宿的Archer（教授）","line":"不管怎么说，迦勒底的介入正是我在等待的。一直一直——数千年间一直在等。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":51,"lineEnd":51}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-006","eventId":"shinjuku-event-c","speaker":"卫宫·Alter","line":"你的话尽是些谎言。正因为虚伪太多，所以我能明白的，也就只有你是邪恶的这点而已。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":52,"lineEnd":52}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-007","eventId":"shinjuku-event-d","speaker":"新宿的Archer","line":"他不是英灵。因为不是英灵，所以是不可能成为从者的。……我们将这种称为'幻灵'。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":55,"lineEnd":55}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-008","eventId":"shinjuku-event-e","speaker":"阿尔托莉雅·Alter","line":"这新宿是背叛和幻惑之城。有人会杀死所爱之人，也有人会救下所恨之人。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":58,"lineEnd":58}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-009","eventId":"shinjuku-event-f","speaker":"贞德·Alter","line":"我所认识的，是那个眼角渗着泪水，害怕着，却依然不会放下手中的盾，不会逃避的你。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":61,"lineEnd":61}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-010","eventId":"shinjuku-event-f","speaker":"卫宫·Alter","line":"生存还是毁灭——但不管你选择哪个，等待你的都是被残忍杀害的结局。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":62,"lineEnd":62}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-011","eventId":"shinjuku-event-g","speaker":"新宿的Archer","line":"那份憎恨，是妻子被杀害程度的憎恨。……狼王罗伯。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":65,"lineEnd":65}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-012","eventId":"shinjuku-event-h","speaker":"新宿的Archer","line":"你拥有身为御主的资格。但是，你真的能在这新宿战斗吗？你——是否能按下炸弹的开关呢？","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":68,"lineEnd":68}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-013","eventId":"shinjuku-event-i","speaker":"新宿的Archer","line":"你表现了你的觉悟，对我来说这样就已经足够了。我是个坏人。但你不需要弄脏你的手。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":71,"lineEnd":71}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-014","eventId":"shinjuku-event-j","speaker":"新宿的Archer（敌）","line":"夏洛克·福尔摩斯。这就是为你准备的舞台。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":74,"lineEnd":74}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-015","eventId":"shinjuku-event-k","speaker":"恶Archer","line":"我计算出了破坏这颗星球所需的力量。会想确认答案是否正确，是数学家的天性。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":77,"lineEnd":77}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-016","eventId":"shinjuku-event-k","speaker":"福尔摩斯","line":"他的名字是詹姆斯·莫里亚蒂。犯罪界的拿破仑。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":78,"lineEnd":78}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-017","eventId":"shinjuku-event-l","speaker":"莫里亚蒂","line":"我的名字乃是詹姆斯·莫里亚蒂。我的身躯，我的力量皆为我的御主而存在。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":81,"lineEnd":81}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-018","eventId":"shinjuku-event-m","speaker":"燕青","line":"阻止我的主人，我明明阻止了。然而那个无可救药的傻瓜却说——没关系，我定能获得荣华富贵！","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":84,"lineEnd":84}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-019","eventId":"shinjuku-event-n","speaker":"贞德·Alter","line":"至死都无法宣泄这憎恨！我们是因憎恨而活的生命体。唯有做着泡影之梦并死去，才是我们复仇者的救赎！","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":87,"lineEnd":87}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-020","eventId":"shinjuku-event-n","speaker":"贞德·Alter","line":"那不是在打倒敌人。而是解放坠落之后，再也无法振翅飞翔的鸟儿。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":88,"lineEnd":88}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-021","eventId":"shinjuku-event-o","speaker":"阿尔托莉雅·Alter","line":"他忘记了迟早要回归的故乡，忘记了陪伴他身旁的那些面庞——连同族的气味都被新宿的味道所掩盖。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":91,"lineEnd":91}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-022","eventId":"shinjuku-event-p","speaker":"阿尔托莉雅·Alter","line":"举起枪来吧，Archer。我不会说什么堂堂正正。你想用多少人就尽管用吧。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":94,"lineEnd":94}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-023","eventId":"shinjuku-event-q","speaker":"达·芬奇","line":"莎士比亚称赞你，是因为他相信能通过你描绘美妙的故事。安徒生帮助你，是因为你让他联想起生前基于理想描写的作品。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":97,"lineEnd":97}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-024","eventId":"shinjuku-event-r","speaker":"莫里亚蒂","line":"我将自己化为零。删去记忆，删去恶性，创造善性，重生了。若非如此，我们是赢不了福尔摩斯和你的。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":100,"lineEnd":100}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-025","eventId":"shinjuku-event-r","speaker":"魔神巴力","line":"不是为了毁灭世界而杀你，而是为了杀你而毁灭世界！","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":101,"lineEnd":101}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-026","eventId":"shinjuku-event-s","speaker":"岩窟王","line":"无论遭遇多么不讲理的因果报应，你都不会为之屈服！呼唤吧，我的名字！","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":104,"lineEnd":104}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"dialogueRef":"shinjuku-dlg-027","eventId":"shinjuku-event-s","speaker":"贞德·Alter","line":"你问我是不是为了对抗才要跳舞？你真蠢。当然是因为想跳才会跳啊。","sourceRefs":[{"sourceUnitId":"src-fgo-eor-shinjuku","path":"sources/worldbook-script/eor/ch-089-shinjuku.txt","lineStart":105,"lineEnd":105}],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"}
  ],
  "skippedQuotes": []
}
