{
  "schema": "tm-fgo-dialogue-index-v1",
  "recordType": "dialogue_index",
  "chapterId": "fgo-lb1-anastasia",
  "dialogueCount": 40,
  "allQuotedDialogueLinesRepresented": true,
  "dialogues": [
    {"id":"dlg-lb1-A0-001","eventId":"evt-fgo-lb1-A0","rawEventCode":"事件A0","speakerRaw":"福尔摩斯","textRaw":"如果在当前情况下存在『看不见的敌人』，那我们就需要『敌人看不见的友方』才行。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:45"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-A0-002","eventId":"evt-fgo-lb1-A0","rawEventCode":"事件A0","speakerRaw":"高扬斯卡娅","textRaw":"毕竟你不仅从他们那里夺走了表现的机会、存在意义，甚至连迦勒底这个归宿都被你夺走了哦。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:46"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-A0-003","eventId":"evt-fgo-lb1-A0","rawEventCode":"事件A0","speakerRaw":"达·芬奇","textRaw":"如果事态发生变化，那毫无疑问会在今年的最后一天，也就是31日。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:47"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-A1-001","eventId":"evt-fgo-lb1-A1","rawEventCode":"事件A1","speakerRaw":"戈尔德鲁夫","textRaw":"一次都没有得到他人的认可！还没有被任何人爱过啊……！","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:50"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-A1-002","eventId":"evt-fgo-lb1-A1","rawEventCode":"事件A1","speakerRaw":"皇女","textRaw":"吾等异闻带残酷而极寒。我要让在这种程度的环境中就感到『寒冷』的他们好好见识一下何谓真正的地狱。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:51"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-A2-001","eventId":"evt-fgo-lb1-A2","rawEventCode":"事件A2","speakerRaw":"达·芬奇","textRaw":"这灵基肖像，可是你们旅途的证明啊。……也是我，以及已经不在之人的骄傲。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:54"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-A2-002","eventId":"evt-fgo-lb1-A2","rawEventCode":"事件A2","speakerRaw":"沃戴姆","textRaw":"泛人类史，于2018年告终。……这颗行星的历史，将由吾等继承。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:55"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-A-001","eventId":"evt-fgo-lb1-A","rawEventCode":"事件A","speakerRaw":"神父","textRaw":"无法自爱者，是绝对无法拯救世界的。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:58"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-A-002","eventId":"evt-fgo-lb1-A","rawEventCode":"事件A","speakerRaw":"皇女","textRaw":"你没能做到，这点是事实。不可以自欺欺人。要展现出你最强的状态。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:59"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-B-001","eventId":"evt-fgo-lb1-B","rawEventCode":"事件B","speakerRaw":"高扬斯卡娅","textRaw":"建立起榨取弱者社会构造的，不就是你们人类吗？","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:62"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-B-002","eventId":"evt-fgo-lb1-B","rawEventCode":"事件B","speakerRaw":"帕茨西","textRaw":"弱者连肉都算不上。我们就是被这样教育的。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:63"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-C-001","eventId":"evt-fgo-lb1-C","rawEventCode":"事件C","speakerRaw":"阿塔兰忒·Alter","textRaw":"不下杀手地与吾等战斗，但是吾等会痛下杀手。假如汝等还是放吾等一条生路——那就是慈爱。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:66"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-C-002","eventId":"evt-fgo-lb1-C","rawEventCode":"事件C","speakerRaw":"帕茨西","textRaw":"对没能做什么感到焦躁，也对没能阻止什么感到焦躁。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:67"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-D-001","eventId":"evt-fgo-lb1-D","rawEventCode":"事件D","speakerRaw":"反叛军士兵","textRaw":"我们毫无疑问会堕入地狱。但至少得在我家小鬼头长大成人前，把伊凡雷帝干掉才行。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:70"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-E-001","eventId":"evt-fgo-lb1-E","rawEventCode":"事件E","speakerRaw":"阿塔兰忒·Alter","textRaw":"光凭仇恨，是很难战斗到最后的。必须紧紧抱着自己思考得出的结论，拼死战斗才行。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:73"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-F-001","eventId":"evt-fgo-lb1-F","rawEventCode":"事件F","speakerRaw":"村长","textRaw":"杀戮猎兵不会回应求救信号。因为他们是只效忠于沙皇的部队。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:76"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-G-001","eventId":"evt-fgo-lb1-G","rawEventCode":"事件G","speakerRaw":"达·芬奇","textRaw":"即便对手是没有任何过错的邻人，你也能为了自己的正义而战吗？","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:79"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-G-002","eventId":"evt-fgo-lb1-G","rawEventCode":"事件G","speakerRaw":"卡多克","textRaw":"这一次，我一定要获得成功。如若不然，我就会被驱逐。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:80"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-H-001","eventId":"evt-fgo-lb1-H","rawEventCode":"事件H","speakerRaw":"贝奥武夫","textRaw":"只要这灵基仍未忘记自己是王——我就会在此处施行德政、拯救苍生。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:83"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-I-001","eventId":"evt-fgo-lb1-I","rawEventCode":"事件I","speakerRaw":"神父","textRaw":"这个异闻带，是无论如何都不会有未来的世界。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:86"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-J-001","eventId":"evt-fgo-lb1-J","rawEventCode":"事件J","speakerRaw":"阿维斯布隆","textRaw":"屠杀并不是恶人杀害大量善人的单纯存在。而是不断蔓延而成的。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:89"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-J-002","eventId":"evt-fgo-lb1-J","rawEventCode":"事件J","speakerRaw":"伊凡雷帝","textRaw":"余并不喜欢这种力量。世间万物都被冻结，又有什么能让余统治啊。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:90"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-K-001","eventId":"evt-fgo-lb1-K","rawEventCode":"事件K","speakerRaw":"帕茨西独白","textRaw":"杀死母亲的……是我……是我害的……","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:93"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-K-002","eventId":"evt-fgo-lb1-K","rawEventCode":"事件K","speakerRaw":"凯妮斯","textRaw":"一定要出奇制胜哦，卡多克。你肯定想让女人看到自己帅气的一面吧？","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:94"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-L-001","eventId":"evt-fgo-lb1-L","rawEventCode":"事件L","speakerRaw":"萨列里","textRaw":"我没能杀掉。我只是无法容忍那天赋之才遭到杀害。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:97"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-L-002","eventId":"evt-fgo-lb1-L","rawEventCode":"事件L","speakerRaw":"卡多克","textRaw":"终于见到你了，最后的御主。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:98"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-M-001","eventId":"evt-fgo-lb1-M","rawEventCode":"事件M","speakerRaw":"卡多克","textRaw":"你只不过凑巧在场，只不过凑巧被选中而已。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:101"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-M-002","eventId":"evt-fgo-lb1-M","rawEventCode":"事件M","speakerRaw":"玛修","textRaw":"正因为有御主咕哒在，我才能活到现在！","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:102"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-N-001","eventId":"evt-fgo-lb1-N","rawEventCode":"事件N","speakerRaw":"萨列里","textRaw":"这异闻带没有音乐。看来只能站在你们这边了。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:105"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-N-002","eventId":"evt-fgo-lb1-N","rawEventCode":"事件N","speakerRaw":"达·芬奇","textRaw":"被剪定的败者历史侵占现实——过滤异闻史现象。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:106"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-O-001","eventId":"evt-fgo-lb1-O","rawEventCode":"事件O","speakerRaw":"阿塔兰忒·Alter","textRaw":"延续了四百五十年的历史即将由汝等来改写！——骰子已然掷出。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:109"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-P-001","eventId":"evt-fgo-lb1-P","rawEventCode":"事件P","speakerRaw":"神父","textRaw":"我没有碰他一根汗毛。他不过是屈服了而已。屈服于伟大沙皇之威光。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:112"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-Q-001","eventId":"evt-fgo-lb1-Q","rawEventCode":"事件Q","speakerRaw":"帕茨西","textRaw":"只要看到这个，无论是谁都一定会屈服。它不是应该拥有人类意志的存在。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:115"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-R-001","eventId":"evt-fgo-lb1-R","rawEventCode":"事件R","speakerRaw":"帕茨西","textRaw":"我想让你绝望，想让你诅咒弱者的身份——因为幸福是我们无法得到的东西。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:118"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-S-001","eventId":"evt-fgo-lb1-S","rawEventCode":"事件S","speakerRaw":"武藏","textRaw":"思考绝不是无益的。放弃思考才会令你的力量变弱。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:121"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-S-002","eventId":"evt-fgo-lb1-S","rawEventCode":"事件S","speakerRaw":"阿维斯布隆","textRaw":"只能由我自己来成为炉心。——我要自白。我曾经杀害过孩子。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:122"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-T-001","eventId":"evt-fgo-lb1-T","rawEventCode":"事件T","speakerRaw":"阿维斯布隆","textRaw":"战斗吧，少年。我始终坚信，人类拥有足以承担起这份责任的坚韧。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:125"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-T-002","eventId":"evt-fgo-lb1-T","rawEventCode":"事件T","speakerRaw":"萨列里","textRaw":"奏响我的愤怒，吾之愤怒，以及——阿马德乌斯的愤怒！","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:126"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-U-001","eventId":"evt-fgo-lb1-U","rawEventCode":"事件U","speakerRaw":"伊凡雷帝","textRaw":"脆弱，而又幸福之人……这'多余的存在'，比任何事物都要美丽。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:129"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb1-U-002","eventId":"evt-fgo-lb1-U","rawEventCode":"事件U","speakerRaw":"帕茨西","textRaw":"挺起胸膛，为你那羸弱的世界战斗。我们的错误肯定有意义……不要输。不要输给这种除了强大一无是处的世界。","sourceRefs":["sources/worldbook-script/lostbelt/ch-093-lb1-anastasia.txt:130"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"}
  ],
