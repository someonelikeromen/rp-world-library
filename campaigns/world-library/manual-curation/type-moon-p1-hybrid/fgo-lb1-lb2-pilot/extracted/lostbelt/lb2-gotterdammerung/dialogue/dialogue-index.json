{
  "schema": "tm-fgo-dialogue-index-v1",
  "recordType": "dialogue_index",
  "chapterId": "fgo-lb2-gotterdammerung",
  "dialogueCount": 30,
  "allQuotedDialogueLinesRepresented": true,
  "dialogues": [
    {"id":"dlg-lb2-A-001","eventId":"evt-fgo-lb2-A","rawEventCode":"事件A","speakerRaw":"拉斯普京","textRaw":"别以为你能够白白送死，卡多克·泽姆露普斯。毕竟你的灵魂注定会被利用、被榨取到最后一刻。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:45"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-B-001","eventId":"evt-fgo-lb2-B","rawEventCode":"事件B","speakerRaw":"笔记遗言","textRaw":"世界为何会变成这个样子呢。从天而降的侵略者为何憎恨人类呢。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:48"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-C-001","eventId":"evt-fgo-lb2-C","rawEventCode":"事件C","speakerRaw":"穆尼尔","textRaw":"简直就像魔力炉心！是足以与在伦敦见到的大圣杯匹敌的怪物啊……！","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:51"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-D-001","eventId":"evt-fgo-lb2-D","rawEventCode":"事件D","speakerRaw":"冰雪女王","textRaw":"不可杀戮。绝不可杀人。我的冰雪不是死，而是我的爱之形态。我绝不容许这片纯白被鲜红所沾染。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:54"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-E-001","eventId":"evt-fgo-lb2-E","rawEventCode":"事件E","speakerRaw":"冰雪女王","textRaw":"为何要杀戮？吾之大地没有贪婪的容身之处。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:57"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-E-002","eventId":"evt-fgo-lb2-E","rawEventCode":"事件E","speakerRaw":"高扬斯卡娅","textRaw":"让我们一起享受永恒的星期三吧？","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:58"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-F-001","eventId":"evt-fgo-lb2-F","rawEventCode":"事件F","speakerRaw":"格尔达","textRaw":"谁都活不了那么久嘛。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:61"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-F-002","eventId":"evt-fgo-lb2-F","rawEventCode":"事件F","speakerRaw":"拿破仑","textRaw":"我是只要有人期待，只要有人渴望某种'如果'，便会尽数回应的男人！","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:62"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-G-001","eventId":"evt-fgo-lb2-G","rawEventCode":"事件G","speakerRaw":"斯卡哈·斯卡蒂","textRaw":"非爱，即杀。敌人杀之，子女爱之。这就是北欧女王，身为北欧之母的我哦。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:65"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-G-002","eventId":"evt-fgo-lb2-G","rawEventCode":"事件G","speakerRaw":"拿破仑","textRaw":"夺回那个什么平面之月，获得空想树的情报。你们只能边保护自己，边达成胜利条件。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:66"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-H-001","eventId":"evt-fgo-lb2-H","rawEventCode":"事件H","speakerRaw":"基尔什塔利亚","textRaw":"魔术王意图用魔术———藉由人类来进行人理烧却，而我不同。我选择藉由神来进行人理编纂。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:69"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-I-001","eventId":"evt-fgo-lb2-I","rawEventCode":"事件I","speakerRaw":"拿破仑","textRaw":"我选择站在你们这方战斗。我不会背叛你们。只会为守护泛人类史而战。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:72"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-I-002","eventId":"evt-fgo-lb2-I","rawEventCode":"事件I","speakerRaw":"志度内","textRaw":"我是，水滴。是碰触到圣杯的某人身上滴落的，小小一滴。名字是———Alterego·志度内———。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:73"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-J-001","eventId":"evt-fgo-lb2-J","rawEventCode":"事件J","speakerRaw":"志度内","textRaw":"听命于隐匿者的赤瞳英灵齐格鲁德。他并不是异闻带从者哦。至少那个灵基还是属于'泛人类史齐格鲁德'的！","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:76"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-K-001","eventId":"evt-fgo-lb2-K","rawEventCode":"事件K","speakerRaw":"斯卡哈·斯卡蒂","textRaw":"我不会杀他们。不要让我重复这句话，奥菲莉娅。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:79"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-K-002","eventId":"evt-fgo-lb2-K","rawEventCode":"事件K","speakerRaw":"高扬斯卡娅","textRaw":"因为你啊，由始至终，就是个没受过他人帮助的人类。因为……迄今为止，你从没有交过任何一位朋友吧？","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:80"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-L-001","eventId":"evt-fgo-lb2-L","rawEventCode":"事件L","speakerRaw":"布伦希尔德","textRaw":"我肯定……肯定……在见到他之后就会无法遏制自己。我会尽可能抑制的。但最后还是可能会像狂战士一般熊熊燃烧。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:83"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-L-002","eventId":"evt-fgo-lb2-L","rawEventCode":"事件L","speakerRaw":"格尔达","textRaw":"就算不是御使，我也很喜欢玛修大人哦！真的很谢谢您愿意回来看我哦！玛修大人！","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:84"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-M-001","eventId":"evt-fgo-lb2-M","rawEventCode":"事件M","speakerRaw":"布伦希尔德","textRaw":"经历了漫长年岁的你们拥有了这个吧。情绪激荡。并受此影响，使出激烈且强劲的枪法。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:87"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-M-002","eventId":"evt-fgo-lb2-M","rawEventCode":"事件M","speakerRaw":"希露德","textRaw":"就算能在性能、输出、装备上都能赢过她……我们，也绝对不可能杀害姐姐大人。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:88"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-N-001","eventId":"evt-fgo-lb2-N","rawEventCode":"事件N","speakerRaw":"齐格鲁德","textRaw":"终于，有人能贯穿齐格鲁德的灵核了……！我一直在等待啊！我一直在等待能杀死我的人！","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:91"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-N-002","eventId":"evt-fgo-lb2-N","rawEventCode":"事件N","speakerRaw":"奥菲莉娅","textRaw":"不行……我明明……受基尔什塔利亚大人所托……！火焰———要来了———！","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:92"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-O-001","eventId":"evt-fgo-lb2-O","rawEventCode":"事件O","speakerRaw":"齐格鲁德","textRaw":"看来在下的肉体给你们添麻烦了。在下认为，只能用行动以示赎罪。绝技准备！太阳魔剑啊，用你的身躯掀起破坏吧！———『坏劫之天轮：Bolverk Gram』！","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:95"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-P-001","eventId":"evt-fgo-lb2-P","rawEventCode":"事件P","speakerRaw":"齐格鲁德","textRaw":"使命一旦完成就会消失。无论是在下还是布伦希尔德，都很清楚这点。此身即为兵刃。此身即为力量。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:98"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-Q-001","eventId":"evt-fgo-lb2-Q","rawEventCode":"事件Q","speakerRaw":"拿破仑","textRaw":"这就是被刻在人理之上的———回应期待的英雄、英灵啊！———英灵拿破仑！正是！回应愿望的男人！","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:101"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-Q-002","eventId":"evt-fgo-lb2-Q","rawEventCode":"事件Q","speakerRaw":"奥菲莉娅","textRaw":"闪耀吧、闪耀吧、闪耀吧！我的……！于此处闪耀吧，我的———大令咒（Sirius Light）———！","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:102"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-R-001","eventId":"evt-fgo-lb2-R","rawEventCode":"事件R","speakerRaw":"苏尔特尔","textRaw":"那个女人。发现了，这样的我。……唯一一个，向郁闷闷烧着的火焰搭话的人。……我能用什么，报答你呢。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:105"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-R-002","eventId":"evt-fgo-lb2-R","rawEventCode":"事件R","speakerRaw":"奥菲莉娅","textRaw":"我一直，都想和你……想和你，成为朋友。……你要，继续前进。迈出步伐，玛修·基列莱特。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:106"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-S-001","eventId":"evt-fgo-lb2-S","rawEventCode":"事件S","speakerRaw":"斯卡哈·斯卡蒂","textRaw":"既然如此，我。就要为了对我一万子民的爱，将你们的几亿，几千亿———不，不！我甚至不惜要亲手夺走那由多的生命！岂能放过这种奇迹！","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:109"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"},
    {"id":"dlg-lb2-S-002","eventId":"evt-fgo-lb2-S","rawEventCode":"事件S","speakerRaw":"希翁","textRaw":"欢迎来到原初的魔术工房，彷徨海·波丹德斯！我是希翁。希翁·艾尔特纳姆·索卡里斯。","sourceRefs":["sources/worldbook-script/lostbelt/ch-094-lb2-gotterdammerung.txt:110"],"sourceType":"user-file-worldbook-script","credibility":"B","canonStatus":"canon-like"}
  ],
