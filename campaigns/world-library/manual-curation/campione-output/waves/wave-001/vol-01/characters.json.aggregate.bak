{"meta":{"series":"campione-main","volume":"vol-01","wave":"wave-001","category":"characters","sourceRefFormat":"campione-main/vol-01/chapters/ch-XXX-标题.txt:行号"},"entities":[{"id":"char-kusanagi-godou","name":"草薙护堂","type":"弑神者／主角","aliases":["第七位弑神者","王","魔王"],"summary":"日本高中生。三月在萨丁尼亚打倒乌鲁斯拉格纳并成为第七位弑神者，平时拒绝魔王身份但会在同伴受害时认真战斗。原为棒球捕手兼第四棒，因弑神后身体能力异常而远离运动社团。","sourceRefs":["campione-main/vol-01/chapters/ch-001-序章.txt:50","campione-main/vol-01/chapters/ch-001-序章.txt:54","campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:120","campione-main/vol-01/chapters/ch-009-终章.txt:146"]},{"id":"char-erica-blandelli","name":"艾莉卡·布兰德里","type":"骑士／魔术师","aliases":["深红恶魔","护堂的第一骑士","赤铜黑十字大骑士"],"summary":"十六岁意大利名门骑士，赤铜黑十字旗下大骑士。任性、骄傲、擅长剑术与魔术，自称护堂爱人与第一骑士，并以狮王之心多次救援护堂。卷末转入城楠学院以长期贴近护堂。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:276","campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:290","campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:408","campione-main/vol-01/chapters/ch-009-终章.txt:166"]},{"id":"char-arianna-hayama-arialdi","name":"亚莉安娜·哈亚马·亚莉阿尔蒂","type":"见习魔术师／随从","aliases":["安娜","亚莉安娜"],"summary":"艾莉卡直属部下，祖父为日本人，日语流利。待人温柔认真，负责护堂接送与日常支援；驾驶极其危险却从未造成伤亡。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:178","campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:214","campione-main/vol-01/chapters/ch-005-第四章 来自远方的敌人.txt:602"]},{"id":"char-mariya-yuri","name":"万里谷佑理","type":"媛巫女／灵视者","aliases":["武藏野媛巫女","佑理"],"summary":"十五岁巫女，任职七雄神社并就读城楠学院。拥有强灵视能力，曾幼年遭遇沃邦侯爵，能辨认弑神者气息；在雅典娜事件中鉴定神名并冒险作为护堂风之化身的引导。","sourceRefs":["campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:22","campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:78","campione-main/vol-01/chapters/ch-005-第四章 来自远方的敌人.txt:60","campione-main/vol-01/chapters/ch-005-第四章 来自远方的敌人.txt:122"]},{"id":"char-amakasu-touma","name":"甘粕冬马","type":"正史编纂委员会特工","aliases":["甘粕"],"summary":"正史编纂委员会成员，穿旧西装、态度轻浮但知识丰富。委托佑理鉴定护堂，并在东京黑暗领域扩张时负责现场联络与情报报告。","sourceRefs":["campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:58","campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:64","campione-main/vol-01/chapters/ch-006-第五章 骑士与王者拭剑一搏.txt:694"]},{"id":"char-athena","name":"雅典娜","type":"不顺从之神／女神","aliases":["三位一体女王","大地与黑暗女神","不顺从的雅典娜"],"summary":"以银发少女姿态登场，追索戈尔贡之石。取回古老之蛇后恢复大地、黑暗、天空睿智三位一体女王的神格，操纵死亡、黑暗、蛇、猫头鹰与石化邪眼；在浜离宫被护堂与艾莉卡合力击败但未被杀死。","sourceRefs":["campione-main/vol-01/chapters/ch-005-第四章 来自远方的敌人.txt:482","campione-main/vol-01/chapters/ch-005-第四章 来自远方的敌人.txt:674","campione-main/vol-01/chapters/ch-008-第七章 不顺从的雅典娜.txt:418","campione-main/vol-01/chapters/ch-008-第七章 不顺从的雅典娜.txt:550"]},{"id":"char-verethragna","name":"乌鲁斯拉格纳","type":"古波斯胜利之神","aliases":["Verethraghna","胜利之神","战神"],"summary":"古波斯神话战神，追随密特拉，具十种化身并象征胜利。被草薙护堂杀害，其权能被护堂篡夺为东方战神。","sourceRefs":["campione-main/vol-01/chapters/ch-001-序章.txt:40","campione-main/vol-01/chapters/ch-001-序章.txt:46","campione-main/vol-01/chapters/ch-001-序章.txt:48","campione-main/vol-01/chapters/ch-001-序章.txt:54"]},{"id":"char-salvatore-doni","name":"萨尔巴特雷·多尼","type":"弑神者／意大利盟主","aliases":["萨尔巴特雷大人"],"summary":"意大利现有的弑神者盟主，打倒凯尔特神王努达而成王。卷中因与护堂决斗受伤并行踪不明，导致意大利骑士团寻求护堂庇护。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:304","campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:386","campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:422"]},{"id":"char-voban","name":"德扬史塔尔·沃邦","type":"弑神者／侯爵","aliases":["沃邦侯爵","巴尔干半岛的魔王"],"summary":"欧洲老牌弑神者，拥有强大破坏性权能；佑理幼年曾与其一面之缘，因而能辨识弑神者。意大利会议认为他会乐于挑战戈尔贡之石引来的女神但过于危险。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:332","campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:102","campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:108"]},{"id":"char-purple-knight","name":"紫之骑士","type":"骑士团统帅／大骑士","aliases":["百合之都统帅"],"summary":"领导百合之都的年轻统帅，与艾莉卡同为大骑士；要求亲眼确认护堂力量，并担任护堂与艾莉卡决斗的见证人。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:286","campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:402","campione-main/vol-01/chapters/ch-003-第二章 与深红恶魔决斗.txt:158"]},{"id":"char-old-lady-grandmaster","name":"老贵妇人统帅","type":"骑士团至高统帅","aliases":["杜林的老统帅"],"summary":"意大利古老骑士团老贵妇人的统帅，参与戈尔贡之石会议与护堂力量见证。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:280","campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:300","campione-main/vol-01/chapters/ch-003-第二章 与深红恶魔决斗.txt:922"]},{"id":"char-she-wolf-grandmaster","name":"雌狼统帅","type":"骑士团至高统帅","aliases":["罗马结社统帅"],"summary":"雌狼骑士团统帅，反对轻易求助异国弑神者；在决斗中近距离观察护堂权能，随后承认其王者力量。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:280","campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:302","campione-main/vol-01/chapters/ch-003-第二章 与深红恶魔决斗.txt:426"]},{"id":"char-john-pluto-smith","name":"约翰·布鲁特·史密斯","type":"弑神者","aliases":["洛杉矶的守护圣者"],"summary":"美国弑神者，被称为关心平民安危的难得王者；因忙于保护西海岸而未被意大利骑士团请求支援。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:344"]},{"id":"char-luo-hao","name":"罗濠教主","type":"弑神者","aliases":["江南的罗濠教主"],"summary":"中国南方的武侠王，统领崇拜自己的结社，意大利会议认为她不会无条件出手。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:356"]},{"id":"char-black-prince","name":"黑王子","type":"弑神者","aliases":["康瓦尔的黑王子"],"summary":"英国系弑神者，被提及为统领自身结社的王之一。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:356"]},{"id":"char-aisha","name":"艾西亚夫人","type":"弑神者","aliases":["亚历山卓的艾西亚夫人"],"summary":"已知六名弑神者之一，在意大利会议中被艾莉卡排除为求援对象。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:358"]},{"id":"char-kusanagi-shizuka","name":"草薙静花","type":"家人／学生","aliases":["静花"],"summary":"护堂小一岁的妹妹，十四岁，城楠学院初中三年级学生。敏锐怀疑护堂与艾莉卡、佑理的关系，经常追问并训斥哥哥。","sourceRefs":["campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:242","campione-main/vol-01/chapters/ch-009-终章.txt:78","campione-main/vol-01/chapters/ch-009-终章.txt:96"]},{"id":"char-kusanagi-ichirou","name":"草薙一朗","type":"家人／祖父","aliases":["护堂的祖父"],"summary":"草薙家祖父，七十余岁仍具魅力与绅士风度，料理拿手，年轻时有风流传闻。","sourceRefs":["campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:398","campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:406","campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:444"]}]}