{"meta":{"series":"campione-main","volume":"vol-01","wave":"wave-001","category":"locations","sourceRefFormat":"campione-main/vol-01/chapters/ch-XXX-标题.txt:行号"},"entities":[{"id":"loc-fiumicino-airport","name":"菲乌米奇诺机场","type":"机场","aliases":["李奥纳多·达文西机场"],"summary":"罗马国际机场，护堂抵达意大利后由亚莉安娜接应。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:8","campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:178"]},{"id":"loc-rome","name":"罗马","type":"城市","summary":"本卷前半主舞台。戈尔贡之石会议、护堂与艾莉卡决斗、雅典娜追索蛇的起点均发生于此。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:752","campione-main/vol-01/chapters/ch-003-第二章 与深红恶魔决斗.txt:1034"]},{"id":"loc-palatine-hill","name":"帕拉蒂尼山","type":"遗迹／决斗场","summary":"罗马七丘之一，靠近罗马竞技场。艾莉卡选择此处作为与护堂决斗、证明其弑神者力量的场地。","sourceRefs":["campione-main/vol-01/chapters/ch-003-第二章 与深红恶魔决斗.txt:156","campione-main/vol-01/chapters/ch-003-第二章 与深红恶魔决斗.txt:184"]},{"id":"loc-colosseum","name":"罗马竞技场","type":"世界遗产／遗迹","summary":"护堂山猪化身误定为攻击目标后遭严重破坏，外界报道为炸弹恐怖攻击。","sourceRefs":["campione-main/vol-01/chapters/ch-003-第二章 与深红恶魔决斗.txt:996","campione-main/vol-01/chapters/ch-003-第二章 与深红恶魔决斗.txt:1034"]},{"id":"loc-calabria-coast","name":"卡拉布里亚海岸","type":"出土地","summary":"戈尔贡之石两个月前被打捞上来的地点。","sourceRefs":["campione-main/vol-01/chapters/ch-002-第一章 罗马假期.txt:756"]},{"id":"loc-kusanagi-house-nezu","name":"草薙家／根津旧书店","type":"住宅","summary":"护堂一家居住在东京都文京区根津的旧书店，戈尔贡之石回国后曾被放在家中壁橱。","sourceRefs":["campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:194","campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:220"]},{"id":"loc-nanayu-shrine","name":"七雄神社","type":"神社","summary":"位于芝公园与东京铁塔附近高台，是佑理担任巫女的地点；护堂在此与佑理会面，并由佑理保管戈尔贡之石。","sourceRefs":["campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:16","campione-main/vol-01/chapters/ch-005-第四章 来自远方的敌人.txt:48","campione-main/vol-01/chapters/ch-005-第四章 来自远方的敌人.txt:560"]},{"id":"loc-jounan-academy","name":"私立城楠学院","type":"学校","summary":"护堂与静花就读的学校，佑理为高中部一年级与茶道社前辈；卷末艾莉卡转入护堂班级。","sourceRefs":["campione-main/vol-01/chapters/ch-004-第三章 王者的日常.txt:546","campione-main/vol-01/chapters/ch-009-终章.txt:142","campione-main/vol-01/chapters/ch-009-终章.txt:208"]},{"id":"loc-tokyo-bay-coast","name":"东京湾附近海边","type":"海岸／初战地点","summary":"艾莉卡以探测术定位雅典娜后，护堂与她在海边首次正式对峙雅典娜并遭死亡之吻击倒。","sourceRefs":["campione-main/vol-01/chapters/ch-005-第四章 来自远方的敌人.txt:602","campione-main/vol-01/chapters/ch-005-第四章 来自远方的敌人.txt:674","campione-main/vol-01/chapters/ch-005-第四章 来自远方的敌人.txt:782"]},{"id":"loc-kasai-nishikasai","name":"葛西／西葛西一带","type":"东京区域","summary":"安娜载护堂追击雅典娜时进入暗夜领域边缘，车辆与电车停摆，护堂在此尝试风之化身。","sourceRefs":["campione-main/vol-01/chapters/ch-006-第五章 骑士与王者拭剑一搏.txt:704"]},{"id":"loc-hamarikyu","name":"浜离宫恩赐庭园","type":"庭园／最终战场","summary":"位于东京湾边，护堂认为夜间无人、空间足够，选择此处与雅典娜决战；战后庭园遭严重破坏。","sourceRefs":["campione-main/vol-01/chapters/ch-008-第七章 不顺从的雅典娜.txt:276","campione-main/vol-01/chapters/ch-008-第七章 不顺从的雅典娜.txt:294"]},{"id":"loc-tokyo-darkness-zone","name":"东京暗夜领域","type":"异常区域","summary":"雅典娜扩张的黑暗笼罩江户川、江东、中央、港区等大范围，造成供电、照明、火与交通异常。","sourceRefs":["campione-main/vol-01/chapters/ch-006-第五章 骑士与王者拭剑一搏.txt:648","campione-main/vol-01/chapters/ch-009-终章.txt:66"]}]}