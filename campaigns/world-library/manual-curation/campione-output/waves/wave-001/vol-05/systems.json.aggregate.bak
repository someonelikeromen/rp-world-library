{"_schema":"rp-entities-v1","world":"campione","series":"campione-main","volume":"vol-05","category":"systems","entities":[{"id":"japanese-magic-society","name":"日本咒术社会结构","type":"world_system","summary":"日本不像欧洲城市魔术结社林立，而是由正史编纂委员会管理城市咒术师、神社灵力场与媛巫女，背后又受四家与幽世元老牵制。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt","campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt"]},{"id":"hime-miko-bloodline-system","name":"媛巫女血脉与教育体系","type":"mystic_system","summary":"委员会掌握容易诞生特殊灵力者的血脉家系，保护、监视并提拔女性灵力者成为媛巫女，能力包括灵视、神灵附体等。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt","campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt"]},{"id":"four-family-politics","name":"四家与委员会政治","type":"political_system","summary":"四家间存在主导权与派系平衡。沙耶宫家掌控委员会核心，清秋院家则能借老先生与政治影响力迫使委员会默许惠那行动。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"yusei-elder-supervision","name":"幽世元老监督机制","type":"supernatural_system","summary":"隐居幽世的半神、圣僧、神人与前不顺从之神等老人，仍对现世日本咒术界施加影响，必要时提醒或测试地上势力。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-009-终章.txt"]},{"id":"astral-world-rules","name":"幽世空间规则","type":"cosmology","summary":"幽世由多个不连续异空间重叠构成，精神与灵魂优先于肉体。普通人进入需仪式与灵药，弑神者虽能适应但仍会迷路。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt"]},{"id":"astral-record-vision","name":"虚空记忆与灵视机制","type":"magic_theory","summary":"灵视从幽世的生与不死境界抽取过去、未来可能性和神格信息。护堂在幽世借战士化身近似灵视般获取须佐之男知识。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt","campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt"]},{"id":"divine-possession-risk","name":"神灵附体风险","type":"magic_rule","summary":"媛巫女可容纳神之御灵借力，但若在幽世等神力增强场域中过度使用，会丧失身心主导权，被神或神具操纵。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt"]},{"id":"divine-sword-ownership","name":"神具所有权与权能转移","type":"artifact_rule","summary":"天丛云剑在失控独立、被护堂以山猪摧毁后，疑似成为护堂夺取的新权能或所有物，但具体原理仍由沙耶宫馨与甘粕保留为推测。","sourceRefs":["campione-main/vol-05/chapters/ch-009-终章.txt"]},{"id":"campione-blessing-transmission","name":"弑神者加护授予","type":"campione_rule","summary":"护堂可通过少年化身将自身权能以加护形式临时赋予庇护对象，提升其生命力、战斗本能和对异界适应性。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"magic-diplomacy","name":"魔术结社外交风险","type":"political_rule","summary":"袭击赤铜黑十字或青铜黑十字的大骑士等同攻击外国外交使者，可能引发国家与结社级冲突，因此委员会虽不满艾莉卡、琍琍亚娜也需谨慎。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt"]}]}