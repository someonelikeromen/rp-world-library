{"_schema":"rp-entities-v1","world":"campione","series":"campione-main","volume":"vol-05","category":"locations","entities":[{"id":"aoyama-cafe","name":"青山咖啡店","type":"urban_site","summary":"艾莉卡与卡莲深夜交易琍琍亚娜创作笔记复印件的露天咖啡店。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt"]},{"id":"yushima-small-shrine","name":"汤岛小神社","type":"shrine","summary":"惠那初登场时占用的无人小神社，位于汤岛小路旁。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt"]},{"id":"tamaura-shrine","name":"玉浦神社","type":"shrine","summary":"汤岛附近小神社，供奉稻荷、日本武尊、弟橘媛。惠那将其作为临时据点，也被艾莉卡与护堂约会途中调查。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt","campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt"]},{"id":"jonan-academy","name":"城楠学院","type":"school","summary":"护堂等人的学校，本卷发生琍琍亚娜转学、泳池偷窥、茶室闹剧、惠那布置咒歌和幽世转移等主要事件。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt","campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt","campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt","campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt"]},{"id":"jonan-tea-room","name":"城楠学院和室栋茶室","type":"school_facility","summary":"茶道社活动场所。惠那借用茶室举行茶会，公开讨论与佑理嫁入护堂家的闹剧。","sourceRefs":["campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt"]},{"id":"jonan-old-building-pool","name":"城楠学院旧校舍与游泳池","type":"school_facility","summary":"男生偷窥事件的舞台。旧校舍被艾莉卡粉碎魔术弄塌，成为惠那观察艾莉卡实力的契机。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt"]},{"id":"nanatsuou-shrine","name":"七雄神社","type":"shrine","summary":"芝公园附近高地神社，佑理任职的灵力场所之一；她在此与惠那重逢并得知其计划。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt"]},{"id":"nezushop-kusanagi-home","name":"根津商店街与草薙家周边","type":"urban_site","summary":"护堂生活圈。艾莉卡、琍琍亚娜在商店街被惠那观察，草薙家则是琍琍亚娜试图照顾护堂的目标。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt"]},{"id":"committee-akasaka-office","name":"正史编纂委员会东京赤坂分室","type":"office","summary":"甘粕深夜办公与同沙耶宫馨通话的据点，体现委员会现代化情报机构与杂乱亚文化气质并存。","sourceRefs":["campione-main/vol-05/chapters/ch-005-第四章 约会的推荐行程.txt"]},{"id":"sayanomiya-house-sanbancho","name":"沙耶宫家三番町别馆","type":"estate","summary":"位于千代田区三番町的大正时代洋楼，藏有沙耶宫家收藏仓库。佑理、琍琍亚娜在此取得幽世救援素材并从庭院返回现世。","sourceRefs":["campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"adachi-futsal-court","name":"足立区区营室内足球场","type":"sports_site","summary":"护堂将与艾莉卡的初次约会误安排为室内足球赛的场地。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt"]},{"id":"ueno-yushima-date-route","name":"上野至汤岛约会路线","type":"urban_route","summary":"护堂与艾莉卡约会后半段经过百货店内衣卖场、上野街区、爱情宾馆街与玉浦神社。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt"]},{"id":"astral-world","name":"幽世／星幽界／生与不死的境界","type":"otherworld","summary":"肉体不易适应、灵魂优先的异世界，由无数不连续空间构成。退休神灵、半神与不死者居住于此，护堂、艾莉卡、惠那在本卷被卷入其中。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-009-终章.txt"]},{"id":"susanoo-mountain-hut","name":"须佐之男的山中小屋","type":"astral_domain","summary":"须佐之男在幽世中支配的暴风深山与小屋，护堂在此会见老先生、黑衣大法师和玻璃之瞳公主。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt"]},{"id":"astral-empty-city","name":"幽世无人街道","type":"astral_domain","summary":"护堂和艾莉卡在幽世迷路后抵达的哥德式无人街区，并在那里完成少年化身加护仪式。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"chidorigafuchi","name":"千鸟渊","type":"battlefield","summary":"皇居护城河与樱花名胜。本卷终战中成为天丛云剑与山猪交战地点，地形与樱花树遭严重破坏。","sourceRefs":["campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt","campione-main/vol-05/chapters/ch-009-终章.txt"]}]}