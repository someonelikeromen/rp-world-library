{"_schema":"rp-entities-v1","world":"campione","series":"campione-main","volume":"vol-05","category":"factions","entities":[{"id":"history-compilation-committee","name":"正史编纂委员会","type":"organization","summary":"日本国家直属咒术管理组织，统筹城市咒术师、媛巫女与情报管制。本卷在惠那行动上受元老限制，只能监视、善后并为幽世救援提供资源。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt","campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"hime-miko","name":"媛巫女","type":"mystic_order","summary":"日本受正史编纂委员会雇用或管理的女性灵力者体系，多来自特殊血脉并接受英才教育。佑理、惠那、馨皆属此体系。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt","campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"four-families","name":"四家","type":"clan_bloc","summary":"清秋院、九法冢、连城、沙耶宫四大古老咒术家系，自古侍奉帝王并影响日本咒术界。清秋院偏武力与政治，沙耶宫构成委员会核心智囊。","sourceRefs":["campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt"]},{"id":"seishuin-family","name":"清秋院家","type":"clan","summary":"四家之一，惠那所属家系，拥有强大政治影响力并推动惠那成为护堂侧室候补及驱逐外国骑士。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt","campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt"]},{"id":"sayanomiya-family","name":"沙耶宫家","type":"clan","summary":"四家之一，正史编纂委员会核心家系。拥有三番町别馆、收藏仓库与政治谈判能力，馨为下任当主。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"elders-yusei","name":"幽世老人／元老","type":"supernatural_authority","summary":"居于幽世、非神非人的老资格存在，包括须佐之男、黑衣大法师和玻璃之瞳公主。他们监督日本咒术界并观察护堂资质。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt","campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-009-终章.txt"]},{"id":"copper-black-cross","name":"赤铜黑十字","type":"magic_association","summary":"意大利米兰名门魔术结社，艾莉卡所属。其在日本的情报网络与艾莉卡的外交能力使她能调查委员会与天丛云剑。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt","campione-main/vol-05/chapters/ch-005-第四章 约会的推荐行程.txt"]},{"id":"bronze-black-cross","name":"青铜黑十字","type":"magic_association","summary":"意大利米兰名门魔术结社，琍琍亚娜所属。与赤铜黑十字并列，因琍琍亚娜留日而被日本侧视为潜在外交与政治因素。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"jonan-tea-club","name":"城楠学院茶道社","type":"school_club","summary":"静花与佑理活动相关的社团，花房明任社长。被惠那以茶具和伴手礼打通，成为多次日常骚动舞台。","sourceRefs":["campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt","campione-main/vol-05/chapters/ch-005-第四章 约会的推荐行程.txt"]},{"id":"kusanagi-family","name":"草薙家","type":"family","summary":"护堂、静花、一朗所在家庭。琍琍亚娜试图进入草薙家承担照顾任务，艾莉卡则重视与未来家人维持关系。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt"]}]}