{"_schema":"rp-entities-v1","world":"campione","series":"campione-main","volume":"vol-05","category":"events","entities":[{"id":"erica-karen-trade","name":"艾莉卡与卡莲交易创作笔记","type":"setup","summary":"艾莉卡深夜在青山咖啡店向卡莲购买琍琍亚娜创作笔记复印件，并交流媛巫女与正史编纂委员会情报。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt"]},{"id":"erica-manji-ambush","name":"艾莉卡遭卍型刀夜袭","type":"conflict","summary":"艾莉卡回家途中被无人操纵的卍型刀袭击，以狮王之心与雷霆加护反击并回收碎片，预示惠那登场。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt"]},{"id":"ena-introduction-yushima","name":"清秋院惠那在汤岛登场","type":"setup","summary":"惠那在汤岛小神社接到老先生指令，翻阅艾莉卡资料并宣布要成为王的小妾、驱逐外国竞争者。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt"]},{"id":"liliana-school-transfer","name":"琍琍亚娜转入城楠学院","type":"school_life","summary":"琍琍亚娜转入护堂班级并用骑士宣言坐到护堂身旁，导致护堂校园日常与恋爱误会进一步混乱。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt"]},{"id":"yuri-ena-meeting-nanatsuou","name":"佑理与惠那在七雄神社会面","type":"setup","summary":"惠那向佑理说明自己受命成为王的小妾，并展示天丛云剑，宣称会先收拾艾莉卡。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt"]},{"id":"committee-meets-ena","name":"委员会与惠那玉浦神社会谈","type":"political","summary":"甘粕与沙耶宫馨拜访玉浦神社，确认惠那行动受老先生与清秋院家支持，委员会难以公开阻止。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt"]},{"id":"pool-peeping-collapse","name":"泳池偷窥与旧校舍崩塌","type":"school_comedy_conflict","summary":"城楠男生试图从旧校舍偷窥女生泳课，艾莉卡以粉碎魔术令老旧校舍崩塌，惠那与甘粕在远处观察她实力。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt"]},{"id":"ena-school-spell-prep","name":"惠那在城楠学院布置八云咒歌","type":"ritual_setup","summary":"惠那清晨在校舍八处墙面以血写下须佐之男咒歌，为后续幽世转移与封锁护堂做准备。","sourceRefs":["campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt"]},{"id":"tea-room-marriage-commotion","name":"茶室入嫁宣言骚动","type":"school_comedy","summary":"惠那借茶道社茶室邀请护堂，公开宣称自己与佑理将嫁入护堂家，迫使佑理承认与护堂关系可能超越普通朋友。","sourceRefs":["campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt"]},{"id":"erica-ena-first-clash","name":"艾莉卡与惠那首次交锋","type":"duel","summary":"艾莉卡试图与惠那政治交涉，惠那以卍型刀使魔挑起战斗并短暂展示天丛云剑，双方因佑理与护堂接近而休兵。","sourceRefs":["campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt"]},{"id":"amakasu-erica-intel","name":"甘粕向艾莉卡透露天丛云情报","type":"investigation","summary":"艾莉卡在深夜拉面店接触甘粕，获知天丛云剑又名草薙剑、与老先生及清秋院家相关，并得知学校有术式机关。","sourceRefs":["campione-main/vol-05/chapters/ch-005-第四章 约会的推荐行程.txt"]},{"id":"date-futsal-failure","name":"艾莉卡与护堂初次约会变成室内足球赛","type":"comedy","summary":"护堂误将与艾莉卡的初次约会安排为与旧棒球友参加室内足球赛，引发艾莉卡不满，但比赛后两人重新单独行动。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt"]},{"id":"school-investigation-and-abduction","name":"学校调查与幽世绑架","type":"turning_point","summary":"艾莉卡带护堂调查玉浦神社与城楠学院术式，遇到惠那后爆发战斗；惠那发动须佐之男术式，以黑暗吞没护堂并送入幽世。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt"]},{"id":"godou-meets-susanoo","name":"护堂在幽世会见须佐之男与老人们","type":"revelation","summary":"护堂在幽世山中小屋见到速须佐之男命、黑衣大法师与玻璃之瞳公主，得知老先生曾是不顺从之神并隐居幽世。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt"]},{"id":"erica-ena-astral-duel","name":"艾莉卡与惠那在幽世决斗","type":"duel","summary":"艾莉卡追入幽世与惠那再战，但惠那借神灵附体和天丛云剑吸收咒力压倒艾莉卡，迫使护堂赶来救援。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt"]},{"id":"youth-blessing-erica","name":"护堂以少年化身赐予艾莉卡加护","type":"power_awaken","summary":"艾莉卡在幽世衰弱濒危，护堂因愤怒与守护欲觉醒少年化身，通过誓约与接吻将乌鲁斯拉格纳加护注入她体内。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt"]},{"id":"yuri-liliana-rescue","name":"佑理与琍琍亚娜准备幽世救援","type":"rescue","summary":"佑理借灵视确定护堂去向，琍琍亚娜主持星幽界仪式，沙耶宫馨提供收藏素材并借机与二人达成政治交换。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"chidorigafuchi-battle","name":"千鸟渊天丛云剑决战","type":"climax","summary":"护堂等人返回现世后，艾莉卡与琍琍亚娜联手迎战被天丛云剑操纵的惠那；艾莉卡借少年加护击败惠那，但天丛云剑巨大化继续战斗。","sourceRefs":["campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"boar-destroys-amakumo","name":"山猪摧毁巨大化天丛云剑","type":"resolution","summary":"护堂以凤救出惠那，在佑理和惠那接吻式辅助下发动山猪，与巨大化天丛云剑在千鸟渊战斗并将其彻底破坏。","sourceRefs":["campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"aftermath-ena-withdraws","name":"天丛云所有权转移与惠那退场","type":"aftermath","summary":"骚动后天丛云剑由沙耶宫家保管，疑似所有权落到护堂身上；惠那因反省暂回老家管教，但宣称将继续作为护堂的女人。","sourceRefs":["campione-main/vol-05/chapters/ch-009-终章.txt"]}]}