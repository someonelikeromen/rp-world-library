{"_schema":"rp-entities-v1","world":"campione","series":"campione-main","volume":"vol-05","category":"abilities","entities":[{"id":"verethragna-youth-blessing","name":"少年化身加护","type":"campione_power","summary":"护堂新掌握的乌鲁斯拉格纳第五化身用法。通过誓约与接吻式仪式，将自身权能与生命力临时赐予庇护对象，使艾莉卡适应幽世、恢复伤势并强化战斗能力。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"verethragna-raptor","name":"凤化身","type":"campione_power","summary":"护堂用于高速行动的化身。本卷以加速状态登上巨大化天丛云剑并救出嵌在刀身上的惠那，副作用是心脏剧痛与暂时无法行动。","sourceRefs":["campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"verethragna-boar","name":"山猪化身","type":"campione_power","summary":"护堂召唤漆黑巨兽破坏巨大目标的化身。终战中被用来摧毁巨大化天丛云剑并严重破坏千鸟渊地形。","sourceRefs":["campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"verethragna-warrior-sword","name":"战士之剑","type":"campione_power","summary":"以神格知识形成斩断神力的黄金言灵剑。护堂在幽世直接获取须佐之男相关知识，并以此压制天丛云剑。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt"]},{"id":"ena-divine-possession","name":"神灵附体","type":"miko_rite","summary":"媛巫女将自身化为神灵容器、借用神力的能力。惠那可借须佐之男与天丛云剑之灵强化战斗，但在幽世过度使用导致身心被神刀操纵。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt","campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt"]},{"id":"amakumo-plunder","name":"天丛云剑略夺","type":"divine_sword_power","summary":"天丛云剑作为征服之剑吸纳悖逆夷狄之力，能夺取对手咒力或加护并转化为己用。惠那曾用此能力削弱艾莉卡。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt","campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"susanoo-eclipse-transfer","name":"须佐之男盗日与幽世转移","type":"divine_rite","summary":"借须佐之男骗子神、盗太阳神格发动的咒术。以日蚀般黑暗吞没目标，将护堂送入幽世。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt"]},{"id":"eightfold-cloud-song","name":"八云立咒歌","type":"japanese_spell","summary":"惠那以血与神刀铁锈气味在城楠学院八处墙面写下的须佐之男咒歌，用作后续发动幽世转移与天丛云剑术式的机关。","sourceRefs":["campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt","campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt"]},{"id":"erica-shattering-magic","name":"粉碎魔术","type":"knight_magic","summary":"艾莉卡擅长的高级魔术，可让无机物爆裂粉碎。用于摧毁旧校舍惩罚偷窥者，也用于破坏惠那的卍型刀使魔。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt","campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt"]},{"id":"lionheart-thunder-blessing","name":"狮王之心雷霆加护","type":"knight_magic","summary":"艾莉卡借阿尔格斯、史特罗佩斯、布隆特斯之名为狮王之心附加雷霆力量，击破袭击自己的卍型刀。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt"]},{"id":"golgotha-spell","name":"各各他的言灵","type":"knight_rite","summary":"艾莉卡将基督受难之灾祸言灵寄宿于狮王之心，使魔剑能伤及神与神具。终战中用于对抗天丛云剑。","sourceRefs":["campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"bow-song","name":"弓之歌","type":"knight_rite","summary":"琍琍亚娜咏唱大卫哀歌，召唤扫罗之剑或约拿单之弓。终战中她准备用约拿单之弓攻击天丛云剑。","sourceRefs":["campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"liliana-witchcraft","name":"魔女术","type":"witchcraft","summary":"琍琍亚娜作为魔女可使用灵视、动物使役、灵药调制与星幽界相关仪式。本卷她主持进入幽世的魔术准备。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt"]},{"id":"spiritual-vision","name":"灵视","type":"mystic_sense","summary":"从幽世或虚空记忆中抽取情报的能力。佑理在本卷凭高命中率追踪护堂失踪真相，来到幽世后更能快速定位目标。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt","campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"kiss-healing-transmission","name":"接吻式恢复法术传递","type":"miko_spell","summary":"佑理将恢复法术通过接吻灌入护堂体内，缓和凤化身副作用；惠那随后也仿效提供辅助，使护堂能发动山猪。","sourceRefs":["campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]}]}