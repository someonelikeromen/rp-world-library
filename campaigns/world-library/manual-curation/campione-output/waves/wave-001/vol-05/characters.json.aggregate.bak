{"_schema":"rp-entities-v1","world":"campione","series":"campione-main","volume":"vol-05","category":"characters","entities":[{"id":"godou-kusanagi","name":"草薙护堂","type":"protagonist","summary":"第七位弑神者。本卷被清秋院惠那与天丛云剑卷入日本侧政治与幽世事件，觉醒乌鲁斯拉格纳少年化身并将加护授予艾莉卡，最终以凤救出惠那、以山猪摧毁巨大化天丛云剑。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt","campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"erica-blandelli","name":"艾莉卡·布兰德里","type":"major","summary":"赤铜黑十字的大骑士，绰号深红恶魔。序章与卡莲交易琍琍亚娜创作笔记并遭卍型刀袭击；随后调查天丛云剑，与惠那多次交锋，并在幽世接受护堂少年化身加护后获得强化。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt","campione-main/vol-05/chapters/ch-005-第四章 约会的推荐行程.txt","campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"liliana-kranjcar","name":"琍琍亚娜·葛兰尼查尔","type":"major","summary":"青铜黑十字的大骑士，转入城楠学院并以照顾主君为名贴身侍奉护堂。她擅长魔女术与骑士剑术，本卷参与救援幽世、与艾莉卡联手迎战被天丛云剑操纵的惠那。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt","campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"yuri-mariya","name":"万里谷佑理","type":"major","summary":"武藏野媛巫女，拥有极强灵视资质。本卷在惠那刺激下承认自己与护堂不会止于普通朋友，并主动协助从幽世救回护堂与艾莉卡，最终以吻传恢复法术帮助护堂发动山猪。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt","campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt","campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"ena-seishuin","name":"清秋院惠那","type":"major","summary":"清秋院家继承人、武藏野最强级媛巫女之一，绰号太刀的媛巫女。奉清秋院与老先生意向接近护堂，携天丛云剑挑战艾莉卡；因在幽世神灵附体过度而被剑操纵，后被护堂救出。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt","campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt","campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt","campione-main/vol-05/chapters/ch-009-终章.txt"]},{"id":"toma-amakasu","name":"甘粕冬马","type":"supporting","summary":"正史编纂委员会东京分室特务人员，直属沙耶宫馨。负责监视惠那与善后，向艾莉卡透露天丛云剑相关情报，并协助佑理、琍琍亚娜取得进入幽世的素材。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt","campione-main/vol-05/chapters/ch-005-第四章 约会的推荐行程.txt","campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]},{"id":"kaoru-sayanomiya","name":"沙耶宫馨","type":"supporting","summary":"正史编纂委员会东京分室室长、沙耶宫家下任当主，也是媛巫女之一。她以男装美少年般姿态活动，擅长政治交涉，在救援护堂时以沙耶宫收藏为筹码要求琍琍亚娜与佑理表态。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt","campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt","campione-main/vol-05/chapters/ch-009-终章.txt"]},{"id":"susanoo","name":"速须佐之男命","type":"divine_elder","summary":"曾经的不顺从之神，现隐居幽世，被日本咒术界称作老先生。拥有天丛云剑相关权威，策动本卷骚动以观察草薙护堂资质，并在幽世与护堂会面。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt","campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-009-终章.txt"]},{"id":"glass-eyed-princess","name":"玻璃之瞳的公主","type":"divine_elder","summary":"居于幽世的非人老人之一，拥有玻璃色瞳孔与古代公主姿态。她通过水盆映出战场并指点护堂在幽世移动，较认可护堂守护女性的资质。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-009-终章.txt"]},{"id":"black-robed-monk","name":"黑衣大法师","type":"divine_elder","summary":"居于幽世的肉身成佛式存在，皮肤干枯如木乃伊。与须佐之男、公主一同观察护堂，对其资质保持保留态度。","sourceRefs":["campione-main/vol-05/chapters/ch-007-第六章 幽世的邂逅.txt","campione-main/vol-05/chapters/ch-009-终章.txt"]},{"id":"shizuka-kusanagi","name":"草薙静花","type":"supporting","summary":"护堂的妹妹，城楠国中部学生兼茶道社成员。持续误会并追责护堂周围女性关系，在茶室与终章多次引发日常喜剧冲突。","sourceRefs":["campione-main/vol-05/chapters/ch-002-第一章 风暴的前兆.txt","campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt","campione-main/vol-05/chapters/ch-009-终章.txt"]},{"id":"karen-jankulovski","name":"卡莲·杨格洛夫斯基","type":"supporting","summary":"琍琍亚娜的专属女仆，暗中将琍琍亚娜创作笔记复印件卖给艾莉卡，并与艾莉卡保持有限度的情报交易关系。","sourceRefs":["campione-main/vol-05/chapters/ch-001-序章.txt"]},{"id":"ariana-hayama-arialdi","name":"亚莉安娜·哈亚马·亚莉阿尔蒂","type":"supporting","summary":"艾莉卡的助手兼女仆，本卷主要被提及为便当与生活安排来源，也被护堂、艾莉卡拿其独创料理开玩笑。","sourceRefs":["campione-main/vol-05/chapters/ch-005-第五章 约会的去向.txt"]},{"id":"miura","name":"三浦","type":"minor","summary":"护堂国中棒球时代友人，高中棒球社投手。邀请护堂参加室内足球赛，间接破坏护堂与艾莉卡的初次约会计划。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt"]},{"id":"rui","name":"瑠伟","type":"minor","summary":"护堂国中棒球时代友人，前二垒手，现踢室内足球。识趣地让护堂与艾莉卡离开，缓和约会闹剧。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt"]},{"id":"nakayama","name":"中山","type":"minor","summary":"护堂国中棒球时代友人，前左外野手，外表粗犷却爱哭。本卷参与室内足球赛。","sourceRefs":["campione-main/vol-05/chapters/ch-006-第五章 约会的去向.txt"]},{"id":"nanami-sorimachi-takagi","name":"名波、反町、高木","type":"minor_group","summary":"城楠学院男生三人组，先后组织泳池偷窥与护堂审议会。其荒唐行动推动旧校舍崩塌、护堂被绑架与屋顶闹剧。","sourceRefs":["campione-main/vol-05/chapters/ch-003-第二章 今天的学校依然骚动着.txt","campione-main/vol-05/chapters/ch-005-第四章 约会的推荐行程.txt"]},{"id":"hanafusa-akira","name":"花房明","type":"minor","summary":"城楠学院茶道社社长，性格温和，被惠那借用茶室并卷入茶会闹剧。","sourceRefs":["campione-main/vol-05/chapters/ch-004-第三章 太刀的媛巫女.txt","campione-main/vol-05/chapters/ch-005-第四章 约会的推荐行程.txt"]},{"id":"sayanomiya-koremichi","name":"沙耶宫惟道","type":"historical","summary":"沙耶宫家上上代当主、正史编纂委员会创始人，曾留学欧洲学习魔术。其死后仍以收藏守护者形式影响沙耶宫仓库。","sourceRefs":["campione-main/vol-05/chapters/ch-008-第七章 天丛云剑.txt"]}]}