{"_schema":"rp-ability-volume-v1","world":"campione","ability_id":"aisha-persephone-healing-vol14","volume":"vol-14","periods":[{"period_id":"vol-14-main","volume":"vol-14","name":{"zh":"帕希芬妮生命治愈"},"summary":"艾西亚夫人从春之女神帕希芬妮处篡夺的治愈权能，能将生命力分给世间万物，瞬间治愈重伤、烧伤甚至濒死者。卷十四中她以此治愈奥古斯塔·劳里卡伤兵，并因此被当地军民奉为圣女。","sourceRef":"campione-main/vol-14/chapters/ch-005-第5章 弑神的圣女.txt","owner":"艾西亚夫人"}],"source_refs":["campione-main/vol-14/chapters/ch-005-第5章 弑神的圣女.txt"]}
